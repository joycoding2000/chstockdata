+def test_P05_missing_field_and_invalid_date(monkeypatch):
+    rows = [{'opendate': '2026-10-16'}, {'opendate': '2026-02-30', 'r0_net': '2'},
+            {'opendate': 'not-a-date', 'r0_net': '3'}, {'r0_net': '4'}]
+    r = recent(monkeypatch, {1: synthetic(rows)})
+    assert r.records[-1]['status'] == 'MISSING_FIELD'
+    assert len(r.anomalies) == 3
+    assert all(x['status'] == 'INVALID_DATE' for x in r.anomalies)
+    assert all(x['amount'] is None for x in r.anomalies)
