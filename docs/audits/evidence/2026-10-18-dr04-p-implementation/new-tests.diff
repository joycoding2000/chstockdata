+    (requests.Timeout('synthetic'), 'NETWORK_ERROR'), (Response(b'', 500), 'HTTP_ERROR'),
+    (Response(b'', 403), 'FORBIDDEN'), (Response(b'', 429), 'RATE_LIMITED'),
+    (Response(b'{}'), 'PARSE_ERROR'), (Response(b'bad json'), 'PARSE_ERROR'),
