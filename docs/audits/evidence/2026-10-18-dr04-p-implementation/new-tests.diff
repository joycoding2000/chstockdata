+@pytest.mark.parametrize('symbol,latest', [('sz000004', '2026-07-20'), ('sz000005', '2025-02-05')])
+def test_P04_stale_security(monkeypatch, symbol, latest):
+    r = recent(monkeypatch, real_pages(symbol), ticker=symbol[2:], exchange='SZ')
+    assert r.attempts[0]['status'] == 'SUCCESS'
+    assert r.freshness == 'STALE' and r.source_max_date == latest
+    assert r.coverage['counts']['MISSING_DATE'] == 5
+    assert r.coverage['numeric_complete_count'] == 0
+    assert r.extra_records and all(x['status'] == 'RAW_ZERO' for x in r.extra_records)
+
+
+@pytest.mark.parametrize('value,status,reason', [
+    (None, 'MISSING_VALUE', 'NULL'), ('', 'MISSING_VALUE', 'EMPTY_STRING'),
+    ('abc', 'INVALID_VALUE', 'NOT_DECIMAL'), ('NaN', 'INVALID_VALUE', 'NOT_FINITE'),
+    ('Infinity', 'INVALID_VALUE', 'NOT_FINITE'), ('-Infinity', 'INVALID_VALUE', 'NOT_FINITE'),
+    (True, 'INVALID_VALUE', 'INVALID_TYPE'), ([], 'INVALID_VALUE', 'INVALID_TYPE'),
+])
+def test_P05_bad_values(monkeypatch, value, status, reason):
+    r = recent(monkeypatch, {1: synthetic([{'opendate': '2026-10-16', 'r0_net': value}])})
+    row = r.records[-1]
+    assert row['status'] == status and row['amount'] is None
+    assert row['variants'][0]['reason'] == reason
+
