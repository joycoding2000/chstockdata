+def overlapping_pages():
+    pages = real_pages('sz300750')
+    p1, p2 = json.loads(pages[1]), json.loads(pages[2])
+    return {1: pages[1], 2: synthetic([p1[-1]] + p2[:19])}, p1, p2
+
+
+def test_P07_identical_duplicate_retains_provenance(monkeypatch):
+    pages, _, _ = overlapping_pages()
+    transport(monkeypatch, pages)
+    r = cs.get_sina_daily_fund_flow('SZ', '300750', target_date='2026-09-15', calendar=calendar())
+    row = next(x for x in r.records if x['business_date'] == '2026-09-11')
+    assert r.status == 'COMPLETE' and r.coverage['numeric_complete_count'] == 5
+    assert row['duplicate_count'] == 1 and len(row['variants']) == 1
+    assert len(row['variants'][0]['references']) == 2
+
