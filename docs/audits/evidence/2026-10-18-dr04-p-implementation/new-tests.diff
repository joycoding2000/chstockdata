+@pytest.mark.parametrize('symbol,exchange', [('sz300750', 'SZ'), ('sh688981', 'SH')])
+def test_P06_real_annual_pages_and_closed_boundaries(monkeypatch, symbol, exchange):
+    calls = transport(monkeypatch, real_pages(symbol))
+    r = cs.get_sina_daily_fund_flow(exchange, symbol[2:], start_date='2025-10-16',
+                                  end_date='2026-10-16', calendar=calendar())
+    assert r.status == 'COMPLETE'
+    assert len(r.records) == 243 and len(r.extra_records) == 17
+    assert r.records[0]['business_date'] == '2025-10-16'
+    assert r.records[-1]['business_date'] == '2026-10-16'
+    assert r.coverage['numeric_complete_count'] == 243
+    assert r.pagination['pages_fetched'] == 13 and len(calls) == 14
+    assert r.pagination['consistency'] == 'OBSERVED_STABLE'
+    # Target window spans the real first/second page boundary.
+    transport(monkeypatch, real_pages(symbol))
+    cross = cs.get_sina_daily_fund_flow(exchange, symbol[2:], target_date='2026-09-15', calendar=calendar())
+    assert cross.status == 'COMPLETE'
+    assert cross.target_dates == ('2026-09-09', '2026-09-10', '2026-09-11', '2026-09-14', '2026-09-15')
+    assert cross.pagination['pages_fetched'] == 2
+
