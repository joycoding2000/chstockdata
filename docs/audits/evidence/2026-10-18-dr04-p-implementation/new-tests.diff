+@pytest.mark.parametrize('kind,stop', [('conflict', 'DUPLICATE_CONFLICT'),
+                                     ('repeated', 'REPEATED_PAGE'), ('drift', 'ANCHOR_DRIFT')])
+def test_P08_pagination_anomalies(monkeypatch, kind, stop):
+    pages, p1, p2 = overlapping_pages()
+    if kind == 'conflict':
+        rows = json.loads(pages[2]); rows[0]['r0_net'] = '999.0000'; pages[2] = synthetic(rows)
+    elif kind == 'repeated':
+        pages[2] = pages[1]
+    else:
+        pages[2] = synthetic([p1[0]] + p2[:19])
+    calls = transport(monkeypatch, pages)
+    r = cs.get_sina_daily_fund_flow('SZ', '300750', target_date='2026-09-15', calendar=calendar())
+    assert r.status != 'COMPLETE' and r.pagination['stop_reason'] == stop
+    assert r.pagination['consistency'] == 'UNKNOWN' and len(calls) == 2
+    if kind == 'conflict':
+        row = next(x for x in r.records if x['business_date'] == '2026-09-11')
+        assert row['status'] == 'DUPLICATE_CONFLICT' and row['amount'] is None
+        assert len(row['variants']) == 2
+
+
+def test_P08_first_page_anchor_recheck(monkeypatch):
+    pages = real_pages('sz300750')
+    changed = json.loads(pages[1]); changed[0]['r0_net'] = '1.0000'
+    calls = transport(monkeypatch, pages, sequence=[pages[1], pages[2], synthetic(changed)])
+    r = cs.get_sina_daily_fund_flow('SZ', '300750', target_date='2026-09-15', calendar=calendar())
+    assert r.pagination['stop_reason'] == 'ANCHOR_DRIFT' and r.status != 'COMPLETE'
+    assert len(calls) == 3 and len(r.responses) == 3
