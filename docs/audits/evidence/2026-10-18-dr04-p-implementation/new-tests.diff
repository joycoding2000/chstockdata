+"""DR04-P: public API acceptance; real bytes + explicitly synthetic defects."""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+from dataclasses import replace
+from datetime import datetime, timezone
+from decimal import Decimal
+from pathlib import Path
+
+import pytest
+import requests
+
+import chstockdata as cs
+
+FIXTURES = Path(__file__).parent / 'fixtures' / 'daily_fund_flow'
+MANIFEST = json.loads((FIXTURES / 'manifest.json').read_text(encoding='utf-8'))
+CALENDAR = json.loads((FIXTURES / 'calendar.json').read_text(encoding='utf-8'))
+
+
+def calendar():
+    return cs.FundFlowCalendar(
+        trading_days=tuple(CALENDAR['days']), source=CALENDAR['source'],
+        version=MANIFEST['calendar_sha256'], covered_start=CALENDAR['start'],
+        covered_end=CALENDAR['end'], completed_through=CALENDAR['end'], qualified=True,
+    )
+
+
+def real_pages(symbol):
+    return {
+        r['params']['page']: (FIXTURES / Path(r['raw_file']).name).read_bytes()
+        for r in MANIFEST['requests'] if r['params']['daima'] == symbol
+    }
+
+
+class Response:
+    def __init__(self, body=b'[]', status=200):
+        self.content = body
+        self.status_code = status
+
+
+def transport(monkeypatch, pages, *, statuses=None, sequence=None):
+    from chstockdata import daily_fund_flow as ff
+    calls = []
+    events = iter(sequence) if sequence is not None else None
+
+    def get(url, **kwargs):
+        calls.append((url, kwargs))
+        assert url == ff.SINA_DAILY_FUND_FLOW_ENDPOINT
+        assert kwargs['allow_redirects'] is False
+        assert kwargs['params']['sort'] == 'opendate'
+        assert kwargs['params']['asc'] == 0
+        page = kwargs['params']['page']
+        event = next(events) if events is not None else pages.get(page, b'[]')
+        if isinstance(event, Exception):
+            raise event
+        if isinstance(event, Response):
+            return event
+        return Response(event, (statuses or {}).get(page, 200))
+
+    monkeypatch.setattr(ff.requests, 'get', get)
+    return calls
+
+
+def recent(monkeypatch, pages=None, *, ticker='600000', exchange='SH', **kwargs):
+    transport(monkeypatch, real_pages('sh600000') if pages is None else pages)
+    return cs.get_sina_daily_fund_flow(
+        exchange, ticker, target_date='2026-10-16', calendar=calendar(), **kwargs,
+    )
+
+
+def synthetic(rows):
+    return json.dumps(rows, ensure_ascii=False).encode('utf-8')
+
+
+def test_P01_precision_and_source(monkeypatch):
+    assert hasattr(cs, 'get_sina_daily_fund_flow'), 'supported public numeric API is missing'
+    r = recent(monkeypatch)
+    by_day = {x['business_date']: x for x in r.records}
+    assert by_day['2026-10-16']['amount'] == '66064341.6800'
+    assert by_day['2026-10-15']['amount'] == '-8176030.7500'
+    assert Decimal(by_day['2026-10-16']['amount']) == Decimal('66064341.6800')
+    assert r.source == 'sina' and r.field == 'r0_net'
+    assert r.currency == 'CNY' and r.unit == '元'
+    rows = json.loads(real_pages('sh600000')[1])
+    rows[0]['r0_net'] = '49.0000'
+    small = recent(monkeypatch, {1: synthetic(rows)})
+    assert small.records[-1]['amount'] == '49.0000'
+    # JSON numeric tokens must also avoid any float conversion.
+    raw = b'[{"opendate":"2026-10-16","r0_net":12345678901234567890.000000000000000049}]'
+    numeric = recent(monkeypatch, {1: raw})
+    assert numeric.records[-1]['amount'] == '12345678901234567890.000000000000000049'
+    assert numeric.records[-1]['variants'][0]['raw_type'] == 'number'
+    json.dumps(numeric.to_dict(), allow_nan=False)
+
+
+def test_P02_raw_zero_unknown_semantics(monkeypatch):
+    transport(monkeypatch, real_pages('sh688432'))
+    r = cs.get_sina_daily_fund_flow('SH', '688432', start_date='2026-09-11',
+                                  end_date='2026-09-11', calendar=calendar())
+    row = r.records[0]
+    assert row['status'] == 'RAW_ZERO' and row['amount'] == '0.0000'
+    assert row['zero_semantics'] == 'UNKNOWN'
+    assert row['variants'][0]['raw_record']['turnover'] == '0'
+    assert r.coverage['numeric_complete_count'] == 1
+    assert r.coverage['semantic_usable_count'] == 0
+
+
+def test_P03_middle_missing_no_borrow(monkeypatch):
+    rows = json.loads(real_pages('sh600000')[1])
+    rows = [row for row in rows if row['opendate'] != '2026-10-14']
+    r = recent(monkeypatch, {1: synthetic(rows)})
+    assert r.target_dates == tuple(CALENDAR['recent_five'])
+    assert r.records[2]['status'] == 'MISSING_DATE'
+    assert r.records[2]['amount'] is None
+    assert r.coverage['denominator'] == 5
+    assert r.coverage['numeric_complete_count'] == 4
+    assert r.status == 'PARTIAL'
+
