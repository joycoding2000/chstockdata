+def test_P10_wall_clock_expires_during_request(monkeypatch):
+    from chstockdata import daily_fund_flow as ff
+    clock = [0.0]
+    monkeypatch.setattr(ff.time, 'monotonic', lambda: clock[0])
+    def slow(*args, **kwargs):
+        clock[0] = 6.0
+        return Response(real_pages('sh600000')[1])
+    monkeypatch.setattr(ff.requests, 'get', slow)
+    r = cs.get_sina_daily_fund_flow('SH', '600000', target_date='2026-10-16', calendar=calendar(),
+                                  budget=cs.FundFlowBudget(max_seconds=5))
+    assert r.status != 'COMPLETE' and r.pagination['stop_reason'] == 'WALL_CLOCK_BUDGET'
+    assert len(r.attempts) == 1
+
+
+def test_P10_wall_clock_includes_parsing(monkeypatch):
+    from chstockdata import daily_fund_flow as ff
+    clock = [0.0]
+    monkeypatch.setattr(ff.time, 'monotonic', lambda: clock[0])
+    parse = ff._parse
+    def slow_parse(body):
+        rows = parse(body)
+        clock[0] = 6.0
+        return rows
+    monkeypatch.setattr(ff, '_parse', slow_parse)
+    r = recent(monkeypatch, budget=cs.FundFlowBudget(max_seconds=5))
+    assert r.status != 'COMPLETE'
+    assert r.pagination['stop_reason'] == 'WALL_CLOCK_BUDGET'
