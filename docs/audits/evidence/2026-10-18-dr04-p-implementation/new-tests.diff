+def test_P12_same_source_and_reconciliation(monkeypatch):
+    from chstockdata import a_stock
+    monkeypatch.setattr(a_stock, '_get_tdx_fund_flow', lambda *a, **k: pytest.fail('TDX forbidden'))
+    rows = [{'opendate': '2026-10-16', 'r0_net': '1'}, {'opendate': '2026-10-15', 'r0_net': '0'},
+            {'opendate': '2026-10-14', 'r0_net': '2'}, {'opendate': '2026-10-14', 'r0_net': '3'}]
+    r = recent(monkeypatch, {1: synthetic(rows)})
+    counts = r.coverage['counts']
+    assert sum(counts.values()) == r.coverage['denominator'] == 5
+    assert counts['NONZERO'] == counts['RAW_ZERO'] == counts['DUPLICATE_CONFLICT'] == 1
+    assert counts['REQUEST_UNRESOLVED'] == 2
+    assert r.coverage['numeric_complete_count'] == 2 and r.coverage['semantic_usable_count'] == 1
+    transport(monkeypatch, {})
+    unknown = cs.get_sina_daily_fund_flow('SH', '600000', target_date='2026-10-16', calendar=None)
+    assert unknown.status == 'UNKNOWN' and unknown.coverage['denominator'] is None
+    assert unknown.freshness == 'UNKNOWN' and not unknown.attempts
+    bad_cal = replace(calendar(), qualified=False)
+    unqualified = cs.get_sina_daily_fund_flow('SH', '600000', target_date='2026-10-16', calendar=bad_cal)
+    assert unqualified.status == 'UNKNOWN'
