+
+def test_P08_changed_anchor_target_is_conflicting_not_consumable(monkeypatch):
+    pages = real_pages('sz300750')
+    changed = json.loads(pages[1])
+    next(row for row in changed if row['opendate'] == '2026-09-15')['r0_net'] = '1.0000'
+    transport(monkeypatch, {}, sequence=[pages[1], pages[2], synthetic(changed)])
+    r = cs.get_sina_daily_fund_flow('SZ', '300750', target_date='2026-09-15', calendar=calendar())
+    row = r.records[-1]
+    assert row['status'] == 'DUPLICATE_CONFLICT' and row['amount'] is None
+    assert len(row['variants']) == 2
+    assert {v['references'][0]['response_index'] for v in row['variants']} == {0, 2}
+    assert r.coverage['numeric_complete_count'] == 4
