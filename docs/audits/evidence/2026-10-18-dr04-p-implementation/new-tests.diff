+def test_fixture_integrity():
+    for request in MANIFEST['requests']:
+        body = (FIXTURES / Path(request['raw_file']).name).read_bytes()
+        assert len(body) == request['bytes']
+        assert hashlib.sha256(body).hexdigest() == request['sha256']
+    assert hashlib.sha256((FIXTURES / 'calendar.json').read_bytes()).hexdigest() == MANIFEST['calendar_sha256']
