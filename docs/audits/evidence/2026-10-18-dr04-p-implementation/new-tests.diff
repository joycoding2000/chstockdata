+def test_P11_time_version_hash_and_old_failure(monkeypatch):
+    old = recent(monkeypatch)
+    raw = real_pages('sh600000')[1]
+    reformatted = recent(monkeypatch, {1: json.dumps(json.loads(raw), indent=2).encode()})
+    assert old.observation_id != reformatted.observation_id
+    assert old.responses[0]['sha256'] != reformatted.responses[0]['sha256']
+    assert old.value_sha256 == reformatted.value_sha256
+    rows = json.loads(raw); rows[0]['r0_net'] = '49.0000'
+    changed = recent(monkeypatch, {1: synthetic(rows)}, previous_observation=old)
+    assert changed.value_sha256 != old.value_sha256
+    assert changed.previous_observation['records'][-1]['amount'] == '66064341.6800'
+    assert old.records[-1]['amount'] == '66064341.6800'
+    transport(monkeypatch, {}, sequence=[requests.Timeout()])
+    failed = cs.get_sina_daily_fund_flow('SH', '600000', target_date='2026-10-16', calendar=calendar(),
+        previous_observation=old, budget=cs.FundFlowBudget(retries=0))
+    assert failed.attempts[0]['status'] == 'NETWORK_ERROR'
+    assert failed.previous_observation['fetched_at'] == old.fetched_at
+    assert failed.coverage['counts']['REQUEST_UNRESOLVED'] == 5
+    assert failed.source_times['first_known_at'] is None
+    assert failed.source_times['revision_status'] == 'UNKNOWN'
+    assert failed.source_times['finality'] == 'UNKNOWN'
+    for a in old.attempts:
+        assert datetime.fromisoformat(a['started_at']).tzinfo == timezone.utc
+        assert datetime.fromisoformat(a['completed_at']) >= datetime.fromisoformat(a['started_at'])
+    evidence = old.responses[0]
+    assert hashlib.sha256(base64.b64decode(evidence['body_base64'])).hexdigest() == evidence['sha256']
+    assert evidence['sha256'] == next(x['sha256'] for x in MANIFEST['requests'] if '002-' in x['raw_file'])
+    with pytest.raises(ValueError):
+        cs.get_sina_daily_fund_flow('SZ', '000004', target_date='2026-10-16', calendar=calendar(), previous_observation=old)
+
