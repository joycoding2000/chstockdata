tr><tr><td rowspan="1" width="252" colspan="1">经营活动现金流出小计</td><td rowspan="1" width="98" colspan="1">4,896,133,131.56</td><td rowspan="1" width="99" colspan="1">18,025,873,469.88</td></tr><tr><td rowspan="1" width="252" colspan="1">经营活动产生的现金流量净额</td><td rowspan="1" width="98" colspan="1">3,932,076,863.39</td><td rowspan="1" width="99" colspan="1">-3,831,827,365.51</td></tr><tr><td rowspan="1" width="252" colspan="1">二、投资活动产生的现金流量：</td><td rowspan="1" width="98" colspan="1"></td><td rowspan="1" width="99" colspan="1"></td></tr><tr><td rowspan="1" width="252" colspan="1">收回投资收到的现金</td><td rowspan="1" width="98" colspan="1">259,000,000.00</td><td rowspan="1" width="99" colspan="1"></td></tr><tr><td rowspan="1" width="252" colspan="1">取得投资收益收到的现金</td><td rowspan="1" width="98" colspan="1"></td><td rowspan="1" width="99" colspan="1"></td></tr><tr><td rowspan="1" width="252" colspan="1">处置固定资产、无形资产和其他长期资产收回的现金净额</td><td rowspan="1" width="98" colspan="1">25,000.00</td><td rowspan="1" width="99" colspan="1"></td></tr><tr><td rowspan="1" width="252" colspan="1">处置子公司及其他营业单位收到的现金净额</td><td rowspan="1" width="98" colspan="1"></td><td rowspan="1" width="99" colspan="1"></td></tr><tr><td rowspan="1" width="252" colspan="1">收到其他与投资活动有关的现金</td><td rowspan="1" width="98" colspan="1"></td><td rowspan="1" width="99" colspan="1"></td></tr><tr><td rowspan="1" width="252" colspan="1">投资活动现金流入小计</td><td rowspan="1" width="98" colspan="1">259,025,000.00</td><td rowspan="1" width="99" colspan="1"></td></tr><tr><td rowspan="1" width="252" colspan="1">购建固定资产、无形资产和其他长期资产支付的现金</td><td rowspan="1" width="98" colspan="1">78,911,648.95</td><td rowspan="1" width="99" colspan="1">2,534,779,347.66</td></tr><tr><td rowspan="1" width="252" colspan="1">投资支付的现金</td><td rowspan="1" width="98" colspan="1">64,519,819.00</td><td rowspan="1" width="99" colspan="1">1,182,337,592.94</td></tr><tr><td rowspan="1" width="252" colspan="1">取得子公司及其他营业单位支付的现金净额</td><td rowspan="1" width="98" colspan="1"></td><td row