<div class="panel" id="fundNetValue">
  <h3 class="h3"><span class="h3-title">基金净值</span></h3>
  <div>
	      <span class="fund-net-value_type highlight J_netValueType" data-value="TOTALNETVALUEPER">累计净值</span>
        <span class="fund-net-value_type J_netValueType" data-value="NETVALUEPER">单位净值</span>
    <label class="form-label">
      <select class="J_selectSmall" id="fundNetValueYear" name="year" style="width: 100px">
          <option value="2026">2026年</option>
          <option value="2025">2025年</option>
          <option value="2024">2024年</option>
          <option value="2023">2023年</option>
      </select>
    </label>
  </div>
  <div 
  	class="fund-net-value_chart"
  	id="fundNetValueChart"
  	data-fund-code="513500"
      data-net-value-type="TOTALNETVALUEPER"
  	data-url="/fund/fundNetValue.json"
  	style="height: 360px">
  </div>
  <div id="fundHisCon">
    <form id="fundHisForm" action="/fund/fundHisDetail.json" method="post" novalidate style="margin-bottom: 25px">
      <input id="fundHisPageNo" type="hidden" name="pageNo" value="1">
      <input type="hidden" name="pageSize" value="10">
      <input type="hidden" name="fundCode" value="513500">
      <span class="form-label date-range">历史明细：
        <input class="form-text form-text--small J_startDate" data-max-date-range="365" type="text" name="startDate" value="2026-07-22" readonly>
        <span class="divider">-</span>
        <input class="form-text form-text--small J_endDate" type="text" name="endDate" value="2026-10-22" readonly>&nbsp;
        <button class="btn-info btn--small" type="submit">查询</button>
      </span>
    </form>
	      <table class="table-default table--border table--small">
	        <thead class="thead-default">
	          <tr>
	            <td>日期</td>
	            <td>单位净值（元）</td>
	            <td>日涨跌</td>
	            <td>最近7天的收益率</td>
	            <td>最近30日的收益率 </td>
	            <td>今年以来的收益率</td>
	            <td>成立以来的收益率</td>
	            <td>累计净值（元）</td>
	            <td>资产净值（元）</td>
	          </tr>
	        </thead>
	        <tbody class="tbody-default J_dataGrid" data-form="#fundHisForm" data-tpl="#fundHisTpl" data-mask="#fundHisCon" data-empty="#fundHisEmpty" data-paginator="#fundHisPaginator" data-page="#fundHisPageNo">
	          <tr id="fundHisEmpty" style="display: none">
	                <td class="col-empty" colspan="9">暂无数据</td>
	          </tr>
	        </tbody>
	      </table>
	      <div class="paginator J_paginator" id="fundHisPaginator" data-form="#fundHisForm" data-async="Y"></div>
	      <script id="fundHisTpl" type="text/template">
        {{#resultList}}
          <tr class="J_render">
            <td>{{date}}</td>
            <td>{{netValuePer}}</td>
            <td>{{#rate}}{{rate}}%{{/rate}}{{^rate}}--{{/rate}}</td>
            <td>{{#weekYield}}{{weekYield}}%{{/weekYield}}{{^weekYield}}--{{/weekYield}}</td>
            <td>{{#monthYield}}{{monthYield}}%{{/monthYield}}{{^monthYield}}--{{/monthYield}}</td>
            <td>{{#thisYearYield}}{{thisYearYield}}%{{/thisYearYield}}{{^thisYearYield}}--{{/thisYearYield}}</td>
            <td>{{#totalYield}}{{totalYield}}%{{/totalYield}}{{^totalYield}}--{{/totalYield}}</td>
            <td>{{#totalNetValue}}{{totalNetValue}}{{/totalNetValue}}{{^totalNetValue}}--{{/totalNetValue}}</td>
            <td>--</td>
          </tr>
        {{/resultList}}
      </script>
  </div>
  <!-- #fundHisCon -->
</div>
