 <script>
     //改变字体大小

        $('.article1 span.fontS').click(function () {
            var index = $(this).index();
            $(this).addClass('on');
            $(this).siblings().removeClass('on');
            changeFont(index)
        });
        function changeFont(index) {
            if (index === 1) {
                $('.article1 .cont p').css('fontSize','16px');
                $('.article1 .cont table td').css('fontSize','16px');
                $('.article1 .cont').css('fontSize','16px');
                $('.article1 .cont span').css('fontSize','16px');
                $('.article1 .cont b').css('fontSize','16px');
                $('.article1 .cont strong').css('fontSize','16px');
                $('.article1 .cont a').css('fontSize','16px');
                $('.article1 .cont div').css('fontSize','16px');
            } else if (index === 0) {
                $('.article1 .cont p').css('fontSize','18px');
                $('.article1 .cont table td').css('fontSize','18px');
                $('.article1 .cont').css('fontSize','18px');
                $('.article1 .cont span').css('fontSize','18px');
                $('.article1 .cont b').css('fontSize','18px');
                $('.article1 .cont strong').css('fontSize','18px');
                $('.article1 .cont a').css('fontSize','18px');
                $('.article1 .cont div').css('fontSize','18px');
            } else {
                $('.article1 .cont p').css('fontSize','14px');
                $('.article1 .cont table td').css('fontSize','14px');
                $('.article1 .cont').css('fontSize','14px');
                $('.article1 .cont span').css('fontSize','14px');
                $('.article1 .cont b').css('fontSize','14px');
                $('.article1 .cont strong').css('fontSize','14px');
                $('.article1 .cont a').css('fontSize','14px');
                $('.article1 .cont div').css('fontSize','14px');
            }
        }
 </script>

