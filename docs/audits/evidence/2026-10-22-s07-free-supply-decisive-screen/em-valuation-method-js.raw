        getHyTabData: function (callback) {
            var that = this;
            var sortType = that.isMuch ? "-1" : "1";
            var sortName = that.type;
            $.ajax({
                url: webconfig.getWebPath('datacenter') + "api/data/v1/get",
                type: 'get',
