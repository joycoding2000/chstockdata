                var data = json && json.result && json.result.data;
                if (!that.isMuch) {
                    data.sort(function (a, b) {
                        return 1 / b[that.type] - 1 / a[that.type];
                    });
                    // data.sort(function (a, b) {
                    //     if(b[that.type] < 0 && a[that.type] < 0 ){
