                    if (item.SECURITY_CODE === stockInfo.code) {
                        that._stockData = item;
                        that._rankIndex = i * 1 + 1;
                    }
                    if (count < 10 && item.SECURITY_CODE != stockInfo.code && item[that.type] > 0) {
                        item.rank = i * 1 + 1;
