-    if direct.exists():
-        return direct
-    if root.exists():
-        for path in sorted(
-            (*root.glob("*/intent.json"), *root.glob("*/intents/*/intent.json"))
-        ):
-            payload = read_json(path)
-            if payload.get("intent_id") == candidate_id:
-                return path
-    raise CliFailure(
-        f"{REASON_CANDIDATE_NOT_FOUND}: no frozen candidate {candidate_id!r} "
