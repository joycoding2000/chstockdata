-@dataclass(frozen=True)
-class OosSnapshotReceipt:
-    """What the OOS intake verified about one materialized OOS snapshot."""
-
-    snapshot_id: str
-    snapshot_digest: str
-    dataset_digest: str
-    min_session: date
-    max_session: date
