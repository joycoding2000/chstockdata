+    except OosError as error:
+        raise _wrap_oos_failure(error) from error
+    catalog_entry = append_entry(
+        _catalog_dir(root),
+        {
+            "lineage_id": intent.lineage_id,
+            "artifact_type": "OOS_FREEZE",
