-    def corporate_actions(
-        self,
-        *,
-        instrument_id: InstrumentId,
-        start_date: date,
-        end_date: date,
-        instrument_kind: str,
-    ) -> RawVendorResponse:
-        """One bounded page of dividend/distribution records for the
