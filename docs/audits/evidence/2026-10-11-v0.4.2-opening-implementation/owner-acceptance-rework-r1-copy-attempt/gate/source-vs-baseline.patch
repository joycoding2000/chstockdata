+"""R2.1 contract: replay frozen parser output through the public composition."""
+import copy
+import hashlib
+import json
+from datetime import datetime
+from pathlib import Path
+
+import pytest
+
+import chstockdata
+
+ROOT = Path(__file__).resolve().parents[1]
+TDX = ROOT / 'docs/audits/evidence/2026-10-10-v0.4.2-tdx-historical-execution'
+OFFICIAL = ROOT / 'tests/fixtures/opening'
+SHAS = {
+    'tdx_history_responses.jsonl': '2644ce583796b412d18c5b4730356e2df95691085dbf0080dfa728ecac08a228',
+    'tdx_opening_page_responses.jsonl': '03c727b674a5233d873e90da234879c60dc0b222f548c2ec3e5f97298d347dbd',
+    'tdx_opening_page_followup_responses.jsonl': '9989c8a427a4a82fb921fef127b50d7f52a111c9feb033d833ed7842f5aa0ccf',
+    'tdx_opening_page_final_responses.jsonl': '5875d32c619d59f18f3bf5f448f1bc8d5f027fc6ce012409e6ab7fb5659a3a34',
+}
+
+
+def api():
+    assert hasattr(chstockdata, 'fetch_historical_opening_evidence'), 'public R2.1 capability missing'
+    from chstockdata import opening_evidence
+    return opening_evidence
+
+
+def records(code, day):
+    found = []
+    for name, sha in SHAS.items():
+        raw = (TDX / name).read_bytes()
+        assert hashlib.sha256(raw).hexdigest() == sha
+        found.extend(r for r in map(json.loads, raw.decode('utf-8').splitlines())
+                     if r['security'] == code and r['date'] == day.replace('-', ''))
+    return found
+
+
+class ReplayClient:
+    def __init__(self, rows):
+        self.rows = rows
+        self.client = self
+    def get_history_minute_time_data(self, market, code, date):
+        return copy.deepcopy(next(r['rows'] for r in self.rows if r['command'].endswith('fb4')))
+    def get_history_transaction_data(self, market, code, start, count, date):
+        row = next(r for r in self.rows if r['command'].endswith('fb5') and r['parameters']['start'] == start)
+        assert (market, code, date, count) == (row['market_id'], row['security'], int(row['date']), 800)
+        return copy.deepcopy(row['rows'])
+    def close(self):
+        pass
+
+
+class Response:
+    def __init__(self, payload, status=200):
+        self.content = payload if isinstance(payload, bytes) else json.dumps(payload).encode()
+        self.status_code = status
+        self.headers = {'Content-Type': 'application/json'}
+    def raise_for_status(self):
+        if self.status_code != 200:
+            raise ConnectionError('fault transport')
+    def json(self):
+        return json.loads(self.content)
+
+
+class ReplayHttp:
+    def __init__(self, payloads):
+        self.payloads = list(payloads)
+        self.requests = []
+    def get(self, url, **kwargs):
+        self.requests.append((url, kwargs))
+        payload = self.payloads.pop(0)
+        if isinstance(payload, Exception):
+            raise payload
+        return Response(payload)
+    post = get
+
+
+def empty(code):
+    return {'announceCount': 0, 'data': []} if code.startswith(('0', '1')) else {
+        'result': [], 'pageHelp': {'pageNo': 1, 'pageCount': 0, 'pageSize': 25, 'total': 0, 'data': []}}
+
+
+def readers(code, day, official=None, mutate=None, versions=('0.11.7', '0.2.7')):
+    m = api()
+    rs = records(code, day)
+    if mutate:
+        mutate(rs)
+    pages = [r for r in rs if r['command'].endswith('fb5')]
+    # Replay a certified bounded page containing all opening rows, or an empty/late control.
+    chosen = next((r for r in pages if any(x.get('time') == '09:30' for x in (r['rows'] or []))), pages[-1])
+    client = ReplayClient(rs)
+    return (m.TdxOpeningReader(client_factory=lambda **kw: client, versions=versions,
+                               page_offsets=(chosen['parameters']['start'],)),
+            m.OfficialOpeningReader(session=ReplayHttp(official or [empty(code)])))
+
+
+def fetch(code='510300', day='2026-09-11', **kwargs):
+    tdx, official = readers(code, day, kwargs.pop('official', None), kwargs.pop('mutate', None),
+                            kwargs.pop('versions', ('0.11.7', '0.2.7')))
+    return chstockdata.fetch_historical_opening_evidence(code, day, tdx_reader=tdx,
+                                                        official_reader=official, **kwargs)
+
+
+@pytest.mark.parametrize('code,price,volume', [('510300', '4.576',352580), ('159915','3.339',557149),
+                                             ('518880','8.91',106411), ('511010','141.177',289)])
+def test_four_real_etf_opening_composition(code, price, volume):
+    result = fetch(code)
+    data = result.data
+    assert data['opening_status'] == 'OPEN_ACTIVITY_CONFIRMED'
+    assert data['tdx_activity']['last_opening_price'] == price
+    assert data['tdx_activity']['opening_volume_lots'] == volume
+    assert data['tdx_activity']['normalization_rule'] == 'tdxpy_0.2.7_0x0fb5_certified_etf_divide_10'
+    assert data['information_available_at'] is None and data['information_basis'] == 'UNKNOWN'
+    assert data['target_execution_at'] == '2026-09-11T09:30:00+08:00'
+    assert data['execution_effect_window']['end'] == '2026-09-11T09:31:00+08:00'
+    assert data['policy_version'] == 'R2.1'
+    assert len(data['evidence_hash']) == 64
+    assert datetime.fromisoformat(result.metadata.retrieved_at).utcoffset().total_seconds() == 0
+    assert result.metadata.capability == 'historical_opening_evidence'
+    assert {a.capability for a in result.metadata.attempts} >= {'mootdx:historical_opening_activity'}
+
+
+@pytest.mark.parametrize('code,day,price', [('688432','2026-09-14','40.9'), ('000002','2015-12-18','22.4')])
+def test_stock_prices_preserved_and_later_halt_does_not_veto_open(code, day, price):
+    result = fetch(code,day)
+    assert result.data['opening_status'] == 'OPEN_ACTIVITY_CONFIRMED'
+    assert result.data['tdx_activity']['last_opening_price'] == price
+    assert result.data['tdx_activity']['normalization_rule'].endswith('stock_identity')
+    assert not result.data['official_block_at_target']
+
+
+@pytest.mark.parametrize('day', ['2016-12-30','2022-12-30'])
+def test_bounded_real_history(day):
+    assert fetch(day=day).data['opening_status'] == 'OPEN_ACTIVITY_CONFIRMED'
+
+
+def event(start='2026-09-11T09:15:00+08:00', end='2026-09-11T10:30:00+08:00', **kwargs):
+    return api().OfficialOpeningEvent(instrument='510300', market='SSE', effective_start=start,
+        effective_end=end, source_url='https://www.sse.com.cn/disclosure/example',
+        raw_sha256='a'*64, certification_basis='explicit secondary-market effective interval',
+        retrieved_at='2026-10-09T13:00:00+00:00', **kwargs)
+
+
+def test_known_full_window_block_plus_positive_activity_is_conflict():
+    data = fetch(known_events=[event()]).data
+    assert data['opening_status'] == 'UNKNOWN'
+    assert data['source_conflict'] and data['official_block_at_target']
+
+
+def test_resume_inside_minute_blocks_target_without_retry():
+    data = fetch(known_events=[event(end='2026-09-11T09:30:30+08:00')]).data
+    assert data['opening_status'] == 'BLOCKED_CONFIRMED'
+    assert not data['source_conflict'] and data['official_block_at_target']
+
+
+def test_halt_start_inside_minute_cannot_order_activity():
+    data = fetch(known_events=[event(start='2026-09-11T09:30:30+08:00')]).data
+    assert data['opening_status'] == 'UNKNOWN'
+    assert data['reason'] == 'boundary_inside_activity_window'
+
