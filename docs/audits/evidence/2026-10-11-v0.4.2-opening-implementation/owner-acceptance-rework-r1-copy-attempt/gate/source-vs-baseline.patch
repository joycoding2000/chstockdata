+    '518880': (1, 'ETF', Decimal('0.001')), '511010': (1, 'ETF', Decimal('0.001')),
+    '513100': (1, 'ETF', Decimal('0.001')), '159509': (0, 'ETF', Decimal('0.001')),
+    '688432': (1, 'STOCK', Decimal('0.01')), '000002': (0, 'STOCK', Decimal('0.01')),
