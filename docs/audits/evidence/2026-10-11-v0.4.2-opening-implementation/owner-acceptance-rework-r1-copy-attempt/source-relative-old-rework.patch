+def owner_interval_fetch(day, *, activity='positive', official=None, known_events=(), current_event=None):
+    """Deterministic injected transport, not historical live qualification."""
+    m = api()
+    rows = [{'time': '09:30', 'price': 22.4, 'vol': 1 if activity == 'positive' else 0}]
+    if activity == 'empty':
+        rows = []
+    rs = [
+        {'command': '0x0fb4', 'rows': [{'price': 22.4, 'vol': rows[0]['vol'] if rows else 0}]},
+        {'command': '0x0fb5', 'parameters': {'start': 0}, 'rows': rows,
+         'market_id': 0, 'security': '000002', 'date': day.replace('-', '')},
+    ]
+    tdx = m.TdxOpeningReader(client_factory=lambda **kw: ReplayClient(rs),
+                             versions=('0.11.7', '0.2.7'), page_offsets=(0,))
+
+    class InjectedCurrentReader(m.OfficialOpeningReader):
+        def read(self, *args):
+            result = super().read(*args)
+            if current_event is not None:
+                result['events'].append(current_event)
+            return result
+
+    reader = InjectedCurrentReader(session=ReplayHttp([empty('000002') if official is None else official]))
+    return chstockdata.fetch_historical_opening_evidence(
+        '000002', day, tdx_reader=tdx, official_reader=reader, known_events=known_events)
+
+
+@pytest.mark.parametrize('day,status,block', [
+    ('2015-12-18', 'OPEN_ACTIVITY_CONFIRMED', False),
+    ('2016-01-04', 'UNKNOWN', True),
+    ('2016-07-04', 'UNKNOWN', False),
+    ('2016-07-05', 'OPEN_ACTIVITY_CONFIRMED', False),
+    ('2022-12-30', 'OPEN_ACTIVITY_CONFIRMED', False),
+])
+def test_owner_authenticated_resume_date_bounds_only_corresponding_halt(day, status, block):
+    data = owner_interval_fetch(day).data
+    assert data['opening_status'] == status
+    assert data['official_block_at_target'] is block
+    assert data['source_conflict'] is block
+    assert data['information_available_at'] is None and data['information_basis'] == 'UNKNOWN'
+    cached = next(e for e in data['official_events'] if e['offline_cache'])
+    expected = next(e for e in api()._known_events() if e.instrument == '000002')
+    from dataclasses import asdict
+    assert cached == asdict(expected)
+    assert cached['effective_end'] is None
+
+
+@pytest.mark.parametrize('activity', ['empty', 'zero'])
+def test_owner_resume_day_unknown_without_positive_activity(activity):
+    data = owner_interval_fetch('2016-07-04', activity=activity).data
+    assert data['opening_status'] == 'UNKNOWN'
+    assert not data['official_block_at_target']
+    assert data['reason'] == 'authenticated_resume_date_clock_unknown'
+
+
+@pytest.mark.parametrize('day', ['2016-07-05', '2022-12-30'])
+@pytest.mark.parametrize('activity', ['empty', 'zero'])
+def test_owner_after_resume_still_requires_positive_tdx(day, activity):
+    data = owner_interval_fetch(day, activity=activity).data
+    assert data['opening_status'] == 'UNKNOWN'
+    assert not data['official_block_at_target'] and not data['source_conflict']
+
+
+@pytest.mark.parametrize('bad', [ConnectionError('injected fault'), b'<html>fault</html>',
+                               {'announceCount': 26, 'data': []},
+                               {'announceCount': 1, 'data': [{'title': 'uncertified stock halt'}]}])
+def test_owner_after_resume_still_requires_successful_complete_official(bad):
+    result = owner_interval_fetch('2022-12-30', official=bad)
+    assert result.data['opening_status'] == 'UNKNOWN'
+    assert result.metadata.partial
+    assert not result.data['official_block_at_target'] and not result.data['source_conflict']
+    assert any(a.is_failure() for a in result.metadata.attempts)
+
+
+@pytest.mark.parametrize('channel', ['caller', 'current'])
+def test_owner_new_ongoing_halt_cannot_be_erased_by_old_resume_date(channel):
+    from dataclasses import replace
+    original = next(e for e in api()._known_events() if e.instrument == '000002')
+    newer = replace(original, effective_start='2022-12-29T09:30:00+08:00', offline_cache=False,
+                    raw_sha256='b' * 64, raw_fields={'resume_date': '2016-07-04', 'verified': True})
+    kwargs = {'known_events': [newer]} if channel == 'caller' else {'current_event': newer}
+    data = owner_interval_fetch('2022-12-30', **kwargs).data
+    assert data['opening_status'] == 'UNKNOWN'
+    assert data['official_block_at_target'] and data['source_conflict']
+    assert len(data['official_events']) == 2
+
+
+@pytest.mark.parametrize('mutation', ['earlier_date', 'source_sha', 'source_url', 'marker', 'date_only'])
+def test_owner_caller_resume_provenance_cannot_self_authenticate(mutation):
+    from dataclasses import replace
+    original = next(e for e in api()._known_events() if e.instrument == '000002')
+    fields = copy.deepcopy(original.raw_fields)
+    changes = {}
+    if mutation == 'earlier_date':
+        fields['resume_date'] = '2016-01-01'
+    elif mutation == 'source_sha':
+        changes['raw_sha256'] = 'c' * 64
+    elif mutation == 'source_url':
+        changes['source_url'] = 'https://example.invalid/self-asserted'
+    elif mutation == 'marker':
+        fields.update(verified=True, resume_date_verified=True)
+    else:
+        fields = {'resume_date': '2016-07-04', 'verified': True}
+    caller = replace(original, raw_fields=fields, **changes)
+    day = '2016-01-04' if mutation == 'earlier_date' else '2022-12-30'
+    data = owner_interval_fetch(day, known_events=[caller]).data
+    assert data['opening_status'] == 'UNKNOWN'
+    assert data['official_block_at_target'] and data['source_conflict']
+    assert len(data['official_events']) == 2
