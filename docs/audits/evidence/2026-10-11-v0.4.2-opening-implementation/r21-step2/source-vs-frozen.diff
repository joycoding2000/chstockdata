+    def historical_suspension_gap(
+        self, request: TradabilityRequest, failure: ProviderFailure
+    ) -> tuple[TradabilityStatus, ...]:
+        """Expose one explicit legacy coverage constraint, never a PIT success."""
+        if (
+            not isinstance(failure, ProviderFailure)
+            or not isinstance(failure.cause, HistoricalSuspensionUnavailableError)
+            or failure.evidence is None
+            or failure.evidence.capability != "tradability"
+            or failure.evidence.request_digest
+            != _request_digest(
+                "tradability",
+                {
+                    "instrument_ids": ",".join(
+                        str(item) for item in sorted(request.instrument_ids)
+                    ),
+                    "session_date": request.session_date.isoformat(),
+                },
+            )
+        ):
+            raise ChStockDataConfigurationError(
+                "not a verified historical suspension coverage failure"
+            )
+        # A multi-instrument first failure cannot certify gaps for remaining requests.
+        if len(request.instrument_ids) != 1:
+            raise ChStockDataConfigurationError(
+                "historical gap requires a single-instrument failure"
+            )
+        return tuple(
+            TradabilityStatus(
+                item,
+                request.session_date,
+                TradabilityStatusKind.UNKNOWN,
+                HISTORICAL_SUSPENSION_GAP,
+                Availability(None, failure.evidence.retrieved_at, AvailabilityBasis.UNKNOWN),
+                failure.evidence.evidence_id + ":vendor:historical_suspension_unavailable",
+            )
+            for item in request.instrument_ids
+        )
+
+    def fetch_historical_opening_evidence(
+        self, request: HistoricalOpeningRequest
+    ) -> ProviderSuccess[HistoricalOpeningEvidence] | ProviderFailure:
+        capability = "historical_opening_evidence"
+        digest = _request_digest(
+            capability,
+            {
+                "instrument_ids": [str(item) for item in sorted(request.instrument_ids)],
+                "session_date": request.session_date.isoformat(),
+            },
+        )
+        if not callable(getattr(self._client, "historical_opening_evidence", None)):
+            return self._failure(
+                error_code=ProviderErrorCode.UNSUPPORTED_CAPABILITY,
+                message="client has no historical opening execution capability",
+                capability=capability,
+                request_digest=digest,
+            )
+        collected = self._collect_frames(
+            capability=capability,
+            request_digest=digest,
+            calls=[
+                (
+                    item,
+                    lambda item=item: self._client.historical_opening_evidence(
+                        instrument_id=item, session_date=request.session_date
+                    ),
+                )
+                for item in sorted(request.instrument_ids)
+            ],
+        )
+        if isinstance(collected, ProviderFailure):
+            return collected
+        frames, retrieved_at, warnings = collected
+        composite, upstream = self._composite(frames)
+        try:
+            records = tuple(
+                HistoricalOpeningEvidence.from_payload(frame["payload"]) for frame in frames
+            )
+            for record, frame in zip(records, frames):
+                if (
+                    str(record.instrument_id) != frame["instrument_id"]
+                    or record.session_date != request.session_date
+                ):
+                    raise ValueError("historical opening identity differs from request")
+        except (ValueError, KeyError, TypeError) as error:
+            return self._failure(
+                error_code=ProviderErrorCode.MALFORMED_DATA,
+                message=str(error),
+                capability=capability,
+                request_digest=digest,
+                payload=composite,
+                upstream_source=upstream,
+                retrieved_at=retrieved_at,
+                cause=error,
+            )
+        return ProviderSuccess(
+            records,
+            self._evidence(
+                capability=capability,
+                payload=composite,
+                upstream_source=upstream,
+                request_digest=digest,
+                record_count=len(records),
+                retrieved_at=retrieved_at,
+                warnings=tuple(warnings),
+            ),
+        )
 
