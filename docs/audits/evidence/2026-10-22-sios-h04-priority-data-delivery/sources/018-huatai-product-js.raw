                        if(data.dayInfo.hasOwnProperty("creationredemptionunit")){
                            // $("#etf-dayinfo-creationredemptionunit").parent().show();
                            $("#etf-dayinfo-creationredemptionunit").html(data.dayInfo.creationredemptionunit);
                        }

                        if(data.dayInfo.hasOwnProperty("creationredemption")){
                            // $("#etf-dayinfo-creationredemption").parent().show();
                            var creationredemption="";
                            if(data.dayInfo.creationredemption==undefined||data.dayInfo.creationredemption==null||data.dayInfo.creationredemption==''){
                                creationredemption="";
                            }else if(data.dayInfo.creationredemption=="1"){
                                creationredemption="允许申购和赎回";
                            }else if(data.dayInfo.creationredemption=="2"){
                                creationredemption=" 允许申购、不允许赎回";
                            }else if(data.dayInfo.creationredemption=="3"){
                                creationredemption="不允许申购、允许赎回";
                            }else{
                                creationredemption="不允许申购和赎回";
                            }
                            $("#etf-dayinfo-creationredemption").html(creationredemption);
                        }

                        if(data.dayInfo.hasOwnProperty("netcreationlimitperuser")){
                            // $("#etf-dayinfo-netcreationlimitperuser").parent().show();
                            if(data.dayInfo.netcreationlimitperuser==null||data.dayInfo.netcreationlimitperuser=='0.00'||data.dayInfo.netcreationlimitperuser=='0'){
                                $("#etf-dayinfo-netcreationlimitperuser").html('不设上限');
                            }else{
                                $("#etf-dayinfo-netcreationlimitperuser").html(data.dayInfo.netcreationlimitperuser);
                            }
                        }
                        if(data.dayInfo.hasOwnProperty("netredemptionlimitperuser")){
                            // $("#etf-dayinfo-netredemptionlimitperuser").parent().show();
                            if(data.dayInfo.netredemptionlimitperuser==null||data.dayInfo.netredemptionlimitperuser=='0.00'||data.dayInfo.netredemptionlimitperuser=='0'){
                                $("#etf-dayinfo-netredemptionlimitperuser").html('不设上限');
                            }else{
                                $("#etf-dayinfo-netredemptionlimitperuser").html(data.dayInfo.netredemptionlimitperuser);
                            }
                        }
                     
					var hasCLPU = data.dayInfo.hasOwnProperty("creationlimitperuser") && data.dayInfo.creationlimitperuser != null && data.dayInfo.creationlimitperuser !== '' && data.dayInfo.creationlimitperuser !== '0.00' && data.dayInfo.creationlimitperuser !== '0';
					var hasCLPA = data.dayInfo.hasOwnProperty("creationlimitperacct") && data.dayInfo.creationlimitperacct != null && data.dayInfo.creationlimitperacct !== '' && data.dayInfo.creationlimitperacct !== '0.00' && data.dayInfo.creationlimitperacct !== '0';

					if (!hasCLPU && !hasCLPA) {
						$("#etf-dayinfo-creationlimitperuser").html('不设上限');
					} else {
						var val = hasCLPU ? data.dayInfo.creationlimitperuser : data.dayInfo.creationlimitperacct;
						$("#etf-dayinfo-creationlimitperuser").html(parseFloat(val.toString().replace(/,/g, '')).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','));
					}
						

                        if(data.dayInfo.hasOwnProperty("redemptionlimitperuser")){
                            // $("#etf-dayinfo-redemptionlimitperuser").parent().show();
                            if(data.dayInfo.redemptionlimitperuser==null||data.dayInfo.redemptionlimitperuser=='0.00'||data.dayInfo.redemptionlimitperuser=='0'){
                                $("#etf-dayinfo-redemptionlimitperuser").html('不设上限');
                            }else{
                                $("#etf-dayinfo-redemptionlimitperuser").html(data.dayInfo.redemptionlimitperuser);
                            }
                        }



                        if(data.dayInfo.hasOwnProperty("netcreationlimit")){
                            // $("#etf-dayinfo-netcreationlimit").parent().show();
                            if(data.dayInfo.netcreationlimit==null||data.dayInfo.netcreationlimit=='0.00'||data.dayInfo.netcreationlimit=='0'){
                                $("#etf-dayinfo-netcreationlimit").html('不设上限');
                            }else{
                                $("#etf-dayinfo-netcreationlimit").html(data.dayInfo.netcreationlimit);
                            }
                        }

                        if(data.dayInfo.hasOwnProperty("netredemptionlimit")){
