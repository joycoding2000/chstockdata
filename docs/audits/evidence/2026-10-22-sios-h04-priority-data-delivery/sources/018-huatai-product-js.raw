                            if(data.dayInfo.netredemptionlimit==null||data.dayInfo.netredemptionlimit=='0.00'||data.dayInfo.netredemptionlimit=='0'){
                                $("#etf-dayinfo-netredemptionlimit").html('不设上限');
                            }else{
                                $("#etf-dayinfo-netredemptionlimit").html(data.dayInfo.netredemptionlimit);
                            }
                        }

                        if(data.dayInfo.hasOwnProperty("creationlimit")){
                            // $("#etf-dayinfo-creationlimit").parent().show();
                            if(data.dayInfo.creationlimit==null||data.dayInfo.creationlimit=='0.00'||data.dayInfo.creationlimit=='0'){
                                $("#etf-dayinfo-creationlimit").html('不设上限');
                            }else{
                                $("#etf-dayinfo-creationlimit").html(data.dayInfo.creationlimit);
                            }
                        }

                        if(data.dayInfo.hasOwnProperty("redemptionlimit")){
                            // $("#etf-dayinfo-redemptionlimit").parent().show();
                            if(data.dayInfo.redemptionlimit==null||data.dayInfo.redemptionlimit=='0.00'||data.dayInfo.redemptionlimit=='0'){
                                $("#etf-dayinfo-redemptionlimit").html('不设上限');
                            }else{
                                $("#etf-dayinfo-redemptionlimit").html(data.dayInfo.redemptionlimit);
