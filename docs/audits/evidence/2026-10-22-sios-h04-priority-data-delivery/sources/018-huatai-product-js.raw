var NODATA = "获取数据异常";


function scrollMenu(id) {
    $(".bottom-nav-item").each(function() {
        var dataId = $(this).attr("data-href");
        if (id == dataId) {
            $(this).addClass('active')
        } else {
            $(this).removeClass('active');
        }
    });
}

function changeYear() {
    $('#year').show();
    $('.select:first').css('background','rgba(242, 244, 246, 1)');
}
// 投资组合-资产净值数据来源点击事件
function changeQuarter() {
    $('#quarter').show();
    $('.select:last').css('background','rgba(242, 244, 246, 1)');
}


function getTimeRemaining(startDate,endDate){
    var total = Date.parse(endDate) - Date.parse(startDate);
    var seconds = Math.floor( (total/1000) % 60 );
    var minutes = Math.floor( (total/1000/60) % 60 );
    var hours = Math.floor( (total/(1000*60*60)) % 24 );
    var days = Math.floor( total/(1000*60*60*24) );
    return{
        total,
        days,
        hours,
        minutes,
        seconds
    };
}


function getFundRate(fundcode){
    $.ajax({
        type: "get",
        url: "/common-web/fundRate/queryByFundCode",
        //url: "/htbr-002/common/003.json",
        data: {
            fundCode: fundcode
        },
        dataType: "json",
        success: function(data) {

            if(data.success){
                if(data.declare.length>0){
                    $(".rgfl>tbody").find('tr').eq(1).hide();
                    var pensionValueShow = false;
                    $.each(data.declare, function(i, e) {
                        if(e.pensionValue !== undefined && e.pensionValue !== '' && e.pensionValue !== null){
                            pensionValueShow = true;
                        }
                    });
                    if(data.declare[0].no!='-1'){
                        if(pensionValueShow){
                            $(".rgfl>tbody").find('tr').eq(0).hide();
                            $(".rgfl>tbody").append('<tr><th width="33.33%">认购金额（M）</th><th width="33.33%">认购费率</th><th width="33.33%">养老金特定认购费率</th></tr>');
                            for(var i=0;i<data.declare.length;i++){
                                $(".rgfl>tbody").append("<tr><td>"+data.declare[i].space+"</td><td>"+data.declare[i].value+"</td><td>"+(data.declare[i].pensionValue?data.declare[i].pensionValue:'--')+"</td></tr>");
                            }
                        }else{
                            for(var i=0;i<data.declare.length;i++){
                                $(".rgfl>tbody").append("<tr><td>"+data.declare[i].space+"</td><td>"+data.declare[i].value+"</td></tr>");
                            }
                        }
                    }else{
                        $(".rgfl>tbody").append("<tr><td colspan='2' class='notext'>"+data.declare[0].value+"</td></tr>");
                    }
                }

                if(data.buy.length>0){
                    $(".sgfl>tbody").find('tr').eq(1).hide();
                    var pensionValueShow = false;
                    $.each(data.buy, function(i, e) {
                        if(e.pensionValue !== undefined && e.pensionValue !== '' && e.pensionValue !== null){
                            pensionValueShow = true;
                        }
                    });
                    if(data.buy[0].no!='-1'){
                        if(pensionValueShow){
                            $(".sgfl>tbody").find('tr').eq(0).hide();
                            $(".sgfl>tbody").append('<tr><th width="33.33%">申购金额（M）</th><th width="33.33%">申购费率</th><th width="33.33%">养老金特定申购费率</th></tr>');
                            for(var i=0;i<data.buy.length;i++){
                                $(".sgfl>tbody").append("<tr><td>"+data.buy[i].space+"</td><td>"+data.buy[i].value+"</td><td>"+(data.buy[i].pensionValue?data.buy[i].pensionValue:'--')+"</td></tr>");
                            }
                        }else{
                            for(var i=0;i<data.buy.length;i++){
                                $(".sgfl>tbody").append("<tr><td>"+data.buy[i].space+"</td><td>"+data.buy[i].value+"</td></tr>");
                            }
                        }
                    }else{
                        $(".sgfl>tbody").append("<tr><td colspan='2' class='notext'>"+data.buy[0].value+"</td></tr>");
                    }
                    $(".sgshfl-value1").text(data.buy[0].space);

                }

                if(data.sale.length>0){
                    $(".shfl>tbody").find('tr').eq(1).hide();
                    if(data.sale[0].no!='-1'){
                        for(var i=0;i<data.sale.length;i++){
                            $(".shfl>tbody").append("<tr><td>"+data.sale[i].space+"</td><td>"+data.sale[i].value+"</td></tr>");
                        }
                    }else{
                        $(".shfl>tbody").append("<tr><td colspan='2' class='notext'>"+data.sale[0].value+"</td></tr>");
                    }
                }

                // 运作费率
                if(data.manage.length>0){
                    $("#yffl-gl").text(data.manage[0].value);
                }

                if(data.trust.length>0){
                    $("#yffl-tg").text(data.trust[0].value);
                }

                if(data.salesServiceFee.length>0){
                    $("#yffl-xs").text(data.salesServiceFee[0].value);
                }

                // 二级市场买卖费率
                if(data.saleOutSite.length>0){
                    $(".sgshfl-value2").text(data.saleOutSite[0].space);
                }

                //浮动管理费
                if(data.floatingMgmt.length>0){
                    var fdglfHTML = '';
                    data.floatingMgmt.forEach(function(item,index){
                        $(".fdglf-box").show();
                        fdglfHTML += `<tr>
                                        <th width="20%">`+ item.space +`</th>
                                        <td style="text-align: left;padding:5px 20px;border-top: 1px solid rgba(161, 166, 176, 1);">`+ item.value +`</td>
                                    </tr>`;
                        // if(item.space == "固定管理费"){
                        //     $("#fdglf-gy").text(item.value);
                        // }else if(item.space == "或有管理费"){
                        //     $("#fdglf-hy").text(item.value);
                        // }else if(item.space == "超额管理费"){
                        //     $("#fdglf-ce").text(item.value);
                        // }
                    });
                    $(".fdglf-box tbody").html(fdglfHTML);
                }else{
                    $(".fdglf-box").hide();
                }

                // 浮动管理费规则
                if(data.floatingMgmtRules.length>0){
                    $(".flgz-box").show();
		    $("#flgz").html(data.floatingMgmtRules[0].value.replace(/\n/g, "<br>"));
                }else{
                    $(".flgz-box").hide();
                }
            }

        }
    })

}

function getTable(fundcode, sDate1, sDate2, pages, isHuobi,bf) {
    $.ajax({
        type: "get",
        url: "/common-web/chart/fundnettable/getFundNetTableJson",
        data: {
            fundcode: fundcode,
            from: sDate1,
            to: sDate2,
            pages: pages,
            siteId: siteId
        },
        dataType: "json",
        success: function(data) {
            var datalist = data.dataList;
            var showassetvalue = false; //首页配置的显示资产净值
            if (datalist.length > 0 && "1" == datalist[0].showassetvalue) {
                showassetvalue = true;
            }
            var currentpage = data.currentPage;
            var totalpage = data.totalPage;
            if (isHuobi == 1) {
                var bfname="";
                if(bf==2){
                    bfname="百";
                }else{
                    bfname="万";
                }
                var tableHtml ='<table width="100%" class="net-fund-value"><thead><tr><th width="33.33%">日期</th><th width="33.33%">'+bfname+'份收益</th><th width="33.33%">七日年化收益率</th>';
            } else {
                var tableHtml ='<table width="100%" class="net-fund-value"><thead><tr><th width="25%">日期</th><th width="25%">单位净值</th><th width="25%">累计净值</th><th width="25%">日涨跌</th>';
            }

            if (showassetvalue) {
                tableHtml += '<th>资产净值</th>';
            }
            tableHtml += '</tr></thead><tbody>';
            if (datalist.length > 0) {
                for (var i = 0; i < datalist.length; i++) {
                    if (isHuobi == 1) {
                        tableHtml += '<tr><td>' + datalist[i].date +'</td><td style="padding:4px;text-align:center">' + parseFloat(datalist[i].incomeunit).toFixed(4) +'</td><td style="padding:4px;text-align:center">' + parseFloat(datalist[i].incomeratio).toFixed(3) + '%</td>';
                    } else {
                        tableHtml += '<tr><td>' + datalist[i].date +'</td><td style="padding:4px;text-align:center">' + datalist[i].netvalue +'</td><td style="padding:4px;text-align:center">' + datalist[i].totalnetvalue +'</td>';
                        if(datalist[i].dayinc>0){
                            tableHtml+='<td class="red" style="padding:4px;text-align:center">' + datalist[i].dayinc.toFixed(2) + '%</td>';
                        }else if(datalist[i].dayinc<0){
                            tableHtml+='<td class="green" style="padding:4px;text-align:center">' + datalist[i].dayinc.toFixed(2) + '%</td>';
                        }else if(datalist[i].dayinc == 0 ){
                            tableHtml+='<td class="red" style="padding:4px;text-align:center">0.00%</td>';
                        }else {
                            tableHtml+='<td style="padding:4px;text-align:center">--</td>';
                        }
                    }

                    if (showassetvalue) {
                        var lastasset = "";
                        var valuedate = datalist[i].date.split("-");
                        if (("06" == valuedate[1] && "30" == valuedate[2]) || ("12" == valuedate[1] &&
                                "31" == valuedate[2])) { //6.30号或12.31号才显示资产净值
                            lastasset = datalist[i].lastasset;
                        }
                        tableHtml += '<td style="padding:4px;">' + lastasset + '</td>';
                    }
                    tableHtml += '</tr>';
                }
            } else {
                tableHtml += '<tr><td colspan="4" style="text-align:center">暂无数据</td></tr>';
            }
            tableHtml += '</tbody></table>';
            if (totalpage > 1) {
                var netvaluePage = '<span class="start-page inline">第<span class="red">' + currentpage +'</span>页</span>';
                netvaluePage += '<span class="total-page inline">共' + totalpage + '页</span>';
                if (currentpage != 1) {
                    netvaluePage += '<span class="page inline" onclick="javascript:getTable(\'' + fundcode +'\',\'' + sDate1 + '\',\'' + sDate2 + '\',\'' + (currentpage - 1) +'-10\','+isHuobi+', '+ bf + ');">&lt;</span>';
                } else {
                    netvaluePage += '<span class="page inline">&lt;</span>';
                }

                if (currentpage == 1) {
                    netvaluePage += '<span class="page inline active">1</span>';
                } else {
                    netvaluePage += '<span class="page inline" onclick="javascript:getTable(\'' + fundcode +'\',\'' + sDate1 + '\',\'' + sDate2 + '\',\'1-10\','+isHuobi+', '+ bf + ');">1</span>';
                }

                if (currentpage > 3) {
                    netvaluePage += '<span class="page inline" onclick="javascript:getTable(\'' + fundcode +'\',\'' + sDate1 + '\',\'' + sDate2 + '\',\'' + (currentpage - 2) + '-10\','+isHuobi+', '+ bf + ');">' + (currentpage - 2) + '</span>';
                }
                if (currentpage > 2) {
                    netvaluePage += '<span class="page inline" onclick="javascript:getTable(\'' + fundcode +'\',\'' + sDate1 + '\',\'' + sDate2 + '\',\'' + (currentpage - 1) + '-10\','+isHuobi+', '+ bf + ');">' + (currentpage - 1) + '</span>';
                }

                if (currentpage != 1 && currentpage != totalpage) {
                    netvaluePage += '<span class="page inline active">' + currentpage + '</span>';
                }

                if (currentpage + 1 < totalpage) {
                    netvaluePage = netvaluePage +'<span class="page inline" onclick="javascript:getTable(\'' + fundcode + '\',\'' +sDate1 + '\',\'' + sDate2 + '\',\'' + (currentpage + 1) + '-10\','+isHuobi+', '+ bf + ');">' + (currentpage + 1) + '</span>';
                }
                if (currentpage + 2 < totalpage) {
                    netvaluePage = netvaluePage +'<span class="page inline" onclick="javascript:getTable(\'' + fundcode + '\',\'' +sDate1 + '\',\'' + sDate2 + '\',\'' + (currentpage + 2) + '-10\','+isHuobi+', '+ bf + ');">' + (currentpage + 2) + '</span>';
                }
                if (currentpage + 3 < totalpage) {
                    netvaluePage = netvaluePage + '<span class="page inline">...</span>';
                }

                if(totalpage>1){
                    if (currentpage == totalpage) {
                        netvaluePage = netvaluePage + '<span class="page inline active">' + totalpage + '</span>';
                    } else {
                        netvaluePage = netvaluePage +'<span class="page inline" onclick="javascript:getTable(\'' + fundcode + '\',\'' +sDate1 + '\',\'' + sDate2 + '\',\'' + (totalpage) + '-10\','+isHuobi+', '+ bf + ');">' + totalpage +'</span>';

                    }
                }



                if (currentpage < totalpage) {
                    netvaluePage += '<span class="page inline" onclick="javascript:getTable(\'' + fundcode +'\',\'' + sDate1 + '\',\'' + sDate2 + '\',\'' + (currentpage + 1) +'-10\','+isHuobi+', '+ bf + ');">&gt;</span>';
                } else {
                    netvaluePage += '<span class="page inline">&gt;</span>';
                }
                netvaluePage +='<span class="search-page-box inline">前往<input id="valuePage" class="search-page inline" type="text">页</span>';
            }
            $('#page-box').html(netvaluePage);
            $('#netvaluePage').html(tableHtml);




            $("#valuePage").bind("keydown", function () {
                if(event.keyCode==13){
                    var tzPage=$(this).val();
                    if(!checkNum(tzPage)){
                        alert("页码只能输入数字")
                        return;
                    }
                    if(tzPage>totalpage){
                        tzPage=totalpage;
                    }
                    getTable(fundcode, sDate1, sDate2, tzPage+'-10', isHuobi,bf);
                }
            });
        }
    });
}

function getContents(pageNumber, categoryId, totalPage, pageSize, liebiaoID, pageID, totalNum) {
    $("#categaryId2").val(categoryId);
    if (totalPage == 0) {
        $("#" + liebiaoID).empty();
        $("#" + pageID).empty();
        $("#" + liebiaoID).append('<div class="info-noData"><p>暂无内容</p></div>')
        return;
    }
    if (pageNumber > totalPage) {
        pageNumber = totalPage;
    }
    $.ajax({
        type: "POST",
        url: "/common-web/cms/content/getContents?noCache=" + new Date().getTime(),
        data: {
            "categoryId": categoryId,
            "pageNumber": pageNumber,
            "pageSize": pageSize
        },
        dataType: "json",
        success: function(data) {
            if (data != null) {
                $("#" + liebiaoID).empty();
                if (data.contents.length > 0) {
                    totalPage = data.totalPage;
                    for (var i = 0; i < data.contents.length; i++) {
                        var content = data.contents[i];
                        $("#" + liebiaoID).append('<li><a href="' + content.url + '" title="' + content.title + '" target="_blank">' +'<div class="news-content-item">' +'<p class="title"><span class="icon"></span>' + content.title + '</p>' +'<p class="date">' + new Date(parseInt(content.activationDate)).format("yyyy-MM-dd") + '</p>' +'</div>' +'</a></li>');
                    }

                    if (totalPage > 1) {
                        bulidPageNavigator(pageNumber, categoryId, totalPage, pageSize, liebiaoID, pageID);
                    }else{
                        $("#" + pageID).empty();
                    }
                } else {
                    $("#" + liebiaoID).append('<div class="info-noData"><p>暂无内容</p></div>')
                }
            }
        }
    });
}


function getAgencyByFundcode(fundcode, pageNumber, pageSize, pageId,type) {
    $.ajax({
        type: "POST",
        url: "/common-web/agency/json/findAgency",
        data: {
            fundcode: fundcode,
            pageNum: pageNumber,
            pageSize: pageSize
        },
        dataType: "json",
        success: function(data) {
            if (data != null) {
                if (data.hasOwnProperty("agencyFundTypeList")) {
                    buildAgencyList(data.agencyFundTypeList, pageNumber,type);
                    bulidPageNavigatorForAgency(fundcode, pageNumber, data.pageBean.totalPage, pageSize, pageId, type);
                } else {
                    if(type==1){
                        $("#xgjg-list").append('<tr><td colspan="4"><div class="info-noData"><p>暂无内容</p></div></td></tr>')
                    }else{
                        $("#xgjg-list").append('<tr><td colspan="3"><div class="info-noData"><p>暂无内容</p></div></td></tr>')
                    }
                }
               /* $('html,body').animate({
                    scrollTop: document.getElementById('xsjg').offsetTop
                }, 200);*/
            }
        }
    });
}

function buildAgencyList(agencyFundTypeList, pageNumber,type) {
    var agencyHtml="";
    if(type==1){
        agencyFundTypeList.forEach(function(item, i) {
            // agencyHtml +="<tr><td>" + ((pageNumber - 1) * 10 + (i + 1)) + "</td><td>" + item.agencyName +"</td><td>" + item.phone + "</td><td>" + item.link + "</td></tr>";
            agencyHtml +="<tr><td>" + ((pageNumber - 1) * 10 + (i + 1)) + "</td><td>" + item.agencyName +"</td><td>" + item.phone + "</td></tr>";
        });
    }else{
        var listNum=agencyFundTypeList.length;
        for(var i=0;i<listNum;i++){
            if(i==0|| i%3==0){
                agencyHtml+='<tr>';
            }
            agencyHtml+="<td>" + agencyFundTypeList[i].agencyName +"</td>";
            if((i+1)%3==0){
                agencyHtml+='</tr>';
            }
        }
        var ys=listNum%3;
        if(ys>0){
            var needAddNum=3-ys;
            for(var i=0;i<needAddNum;i++){
                agencyHtml+="<td></td>";
            }
            agencyHtml+='</tr>';
        }
    }

    $("#xgjg-list").html(agencyHtml);
}

function bulidPageNavigatorForAgency(fundcode, pageNumber, totalPage, pageSize, pageID, type) {
    $("#" + pageID).empty();
    var fenyes = "";
    fenyes += '<span class="start-page inline">第<span class="red">' + pageNumber + '</span>页</span>';
    fenyes += '<span class="total-page inline">/共' + totalPage + '页</span>';
    if (pageNumber != 1) {
        fenyes += "<span class='page inline' onclick='javascript:getAgencyByFundcode(\"" + fundcode + "\"," +
            (pageNumber-1) + "," + pageSize + ",\"" + pageID + "\"," + type + ")'>&lt;</span>";
    } else {
        fenyes += '<span class="page inline">&lt;</span>';
    }

    if (pageNumber == 1) {
        fenyes += '<span class="page inline active">1</span>';
    } else {
        fenyes += "<span class='page inline' onclick='javascript:getAgencyByFundcode(\"" + fundcode + "\"," +1+ "," + pageSize + ",\"" + pageID + "\"," + type + ")'>1</span>";
    }


    if (pageNumber > 4) {
        fenyes += "<span class='page inline'>...</span>";
    }

    if (pageNumber > 3) {
        fenyes += "<span class='page inline' onclick='javascript:getAgencyByFundcode(\"" + fundcode + "\"," + (pageNumber - 2) + "," + pageSize + ",\"" + pageID + "\"," + type + ")'>" + (pageNumber - 2) +"</span>";
    }
    if (pageNumber > 2) {
        fenyes += "<span class='page inline' onclick='javascript:getAgencyByFundcode(\"" + fundcode + "\"," + (pageNumber - 2) + "," + pageSize + ",\"" + pageID + "\"," + type + ")'>" + (pageNumber - 1) +"</span>";
    }

    if (pageNumber != 1 && pageNumber != totalPage) {
        fenyes += '<span class="page inline active">' + pageNumber + '</span>';
    }

    if (pageNumber + 1 < totalPage) {
        fenyes += "<span class='page inline' onclick='javascript:getAgencyByFundcode(\"" + fundcode + "\"," + (pageNumber + 1) + "," + pageSize + ",\"" + pageID + "\"," + type + ")'>" + (pageNumber + 1) +"</span>";
    }
    if (pageNumber + 2 < totalPage) {
        fenyes += "<span class='page inline' onclick='javascript:getAgencyByFundcode(\"" + fundcode + "\"," + (pageNumber + 2) + "," + pageSize + ",\"" + pageID + "\"," + type + ")'>" + (pageNumber + 2) +"</span>";
    }
    if (pageNumber + 3 < totalPage) {
        fenyes += '<span class="page inline">...</span>';
    }
    if(totalPage>1){
        if (pageNumber == totalPage) {
            fenyes += '<span class="page inline active">' + totalPage + '</span>';
        } else {
            fenyes += "<span class='page inline' onclick='javascript:getAgencyByFundcode(\"" + fundcode + "\"," +totalPage + "," + pageSize + ",\"" + pageID + "\"," + type + ")'>" + totalPage + "</span>";

        }
    }

    if (pageNumber < totalPage) {
        fenyes += "<span class='page inline' onclick='javascript:getAgencyByFundcode(\"" + fundcode + "\"," + (pageNumber + 1) + "," + pageSize + ",\"" + pageID + "\"," + type + ")'>&gt;</span>";
    } else {
        fenyes += '<span class="page inline">&gt;</span>';
    }

    fenyes += '<span class="search-page-box inline">前往<input id="agencypage"  class="search-page inline" type="text">页</span>';
    $("#" + pageID).html(fenyes);

    $("#agencypage").bind("keydown", function () {
        if(event.keyCode==13){
            var tzPage=$(this).val();
            if(!checkNum(tzPage)){
                alert("页码只能输入数字")
                return;
            }
            if(tzPage>totalPage){
                tzPage=totalPage;
            }
            getAgencyByFundcode(fundcode, tzPage, pageSize, pageID, type);
        }
    });
}




function getEtfInfoByFundcode(fundcode, beginDate) {
    $.ajax({
        type: "POST",
        url: "/etf-web/etf/index.json",
        data: {
            fundcode: fundcode,
            beginDate: beginDate
        },
        dataType: "json",
        success: function(data) {
            if (data != null) {
                if (data.status == 'success') {

                    if(Object.keys(data.dayInfo).length == 0) {
                        $("#sgshqd .nav-content").find(".news-title-box").siblings().hide()
                        $("#sgshqd .nav-content").find(".no-mess-tip").show()
			$(".download-file").attr("disabled", "disabled")
                        return;
                    }else {
                        $("#sgshqd .nav-content").find(".news-title-box").siblings().show()
                        $("#sgshqd .nav-content").find(".no-mess-tip").hide()
                    }
                    const etfNeedShowId = ['maxcashratio','estimatecashcomponent','publish','creationredemptionunit','creationredemption','netcreationlimitperuser','netredemptionlimitperuser','creationlimitperuser','redemptionlimitperuser','netcreationlimit','netredemptionlimit','creationlimit','redemptionlimit','lasttenminuteredemptionlimit','cashcomponent','navpercu','nav'];
                    const eftNeedShowId = ['allcashflagstr','allcashamount','allcashpremiumrate','allcashdiscountrate','rtgsflag','creationredemptionmechanism'];

                    etfNeedShowId.forEach((i,arr)=>{
                        $("#etf-dayinfo-"+i).text('无');
                    })
                    eftNeedShowId.forEach((i,arr)=>{
                        $("#eft-dayinfo-"+i).text('无');
                    })

                    $("#etf-noticedate").html(data.maxDate);
                    $("#etf-fundcode").html(data.fundcode);
                    $("#etf-fundname").html(data.fundname);
                    $("#etf-managername").html("华泰柏瑞基金管理有限公司");
                    $("#etf-yestodydate").html("<span class='badge inline'></span>" + data.yestoday +"日信息内容");
                    if (Object.keys(data.dayInfo).length > 0) {
                        $("#etf-dayinfo-cashcomponent").html(data.dayInfo.cashcomponent);
                        $("#etf-dayinfo-navpercu").html(data.dayInfo.navpercu);
                        $("#etf-dayinfo-nav").html(data.dayInfo.nav);
                        $("#etf-maxdate").html("<span class='badge inline'></span>" + data.maxDate +"日信息内容");
                        
                        if(data.dayInfo.hasOwnProperty("securityidsource")){
                            $("#etfType").val(data.dayInfo.securityidsource)
                        }
                        if(data.dayInfo.hasOwnProperty("allcashflagstr")){
                            $("#allcashflagstr").val(data.dayInfo.allcashflagstr)
                        }
                        
                        if(data.dayInfo.hasOwnProperty("maxcashratio")){
                            // $("#etf-dayinfo-maxcashratio").parent().show();
