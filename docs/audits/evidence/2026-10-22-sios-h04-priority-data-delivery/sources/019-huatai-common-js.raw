    $(function () {
        $('#queryString1').bind('keyup', function(event) {
            if (event.keyCode == "13") {
                //回车执行查询
                $('#fund-search-img').click();
            }
        });
        $('#fund-search-img').on('click', function () {
            var urlParam;
            var is_hot_word = false;
            var key_word;
            if($('#queryString1').val() != ""){
                urlParam = "queryString=" + $('#queryString1').val();
                key_word = $('#queryString1').val();
            }else{
                urlParam = "queryString=" + $('#queryString1').attr('placeholder');
                is_hot_word = true;
                key_word = $('#queryString1').attr('placeholder');
            }
            var siteId = "siteId=" + $('#siteId1').val();
            var URL = "/search.html";
            var encordedUrl = URL+"?"+encodeURI(urlParam)+"&"+siteId;
            document.location.href = encordedUrl;
            searchResult(is_hot_word, key_word);
        })
    })


    //导航当前状态
    function navCurrent(){
        var fullUrl = window.location.href;
        var products = new RegExp("\/products\/","i");
        var myAccount = new RegExp("\/myAccount\/","i");
        var special = new RegExp("\/special\/","i");
        var news = new RegExp("\/news\/","i");
        var service = new RegExp("\/service\/","i");
        var aboutUs = new RegExp("\/aboutUs\/","i");

            if(products.test(fullUrl))
            current(1);
            else if(myAccount.test(fullUrl))
            current(2);
            else if(special.test(fullUrl))
            current(3);
            else if(news.test(fullUrl))
            current(4);
            else if(service.test(fullUrl))
            current(5);
            else if(aboutUs.test(fullUrl))
            current(6);
    }
    function current(n){
        $(".menu_title_item li").eq(n).addClass("li_active");
    }
    $(function(){
		navCurrent();
		$(".menu_openAccoun").click(function(){
			location.href="https://etrade.huatai-pb.com/etrading/account/register/frame#";
		});
		
		$(".menu_login").click(function(){
			location.href="https://etrade.huatai-pb.com/etrading/";
		});
	});



    function addBookmark(){
        var sURL=window.location.href;
        var sTitle=$('title').html();
        try{
            window.external.addFavorite(sURL,sTitle);}
        catch(e){
            try{window.sidebar.addPanel(sTitle,sURL,"");}
            catch (e){alert("您的浏览器不支持此功能，请使用Ctrl+D进行添加!");}
        }
    }


function seekProject(fundcode){
    var fundproject = {
        "fundcode": "--",
        "fundtype":"--",
        "indexhotincval":"--",
        "indexhotincname":"--",
        "fundFullName":"--",
        "property":"--",
        "managerName":"--",
        "trusteeName":"--",
        "operationMode":"--",
        "performanceBenchmark":"--",
        "investmentIdea":"--",
        "investmentTarget":"--",
        "investmentScope":"--",
        "investmentStrategy":"--",
        "riskFeature":"--",
        "fundname":"--",
        "brokername":"--",
        "subscriptionEndDate":"--",
        "subscriptionBeginDate":"--",
        "url":"#",
        "url1":"--",
        "url2":"--",
        "lastasset":"--",
        "limitmoney":"--",
	"limitmoneytemp":"--",
        "buypoint":"--",
        "netprecision":"--",
        "curStatus":"--",
        "allAttributes":"--",
        "extend": "",
        "tags": "--",
        "fundrate":"--",
        "valuedate":"--",
        "incomeunit":"--",
        "incomeratio":"--",
        "todaynetvalue":"--",
        "todaytotalnetvalue":"--",
        "rate":"--",
        "hot":"--",
        "close":"--",
        "status":"--",
        "statusStr":"--",
        "description":"--",
        "levelofrisk":"--",
        "levelofriskStr":"--",
        "fundgroup":"--",
        "valuagrstate":"--",
        "setupdate":"--",
        "inc":"--",
        "syldate":"--",
        "weekinc":"--",
        "monthinc":"--",
        "seasoninc":"--",
        "halfinc":"--",
        "f1yearinc":"--",
        "f2yearinc":"--",
        "f3yearinc":"--",
        "thisyearinc":"--",
        "f5yearinc":"--",
        "investmentProportion":"--"
    }
    if(FundArr.length > 0){
        for (var i=0; i < FundArr.length; i++) {
            if(FundArr[i].fundcode === fundcode){
                fundproject = FundArr[i];
            }
        }
        return fundproject;
    }
}

