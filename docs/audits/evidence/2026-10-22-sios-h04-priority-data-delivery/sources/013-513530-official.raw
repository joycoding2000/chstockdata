        $(".download-file").click(function(){
            var date=$("#date").val().replace(new RegExp("-","gm"),"");
            var securityidsource=$("#etfType").val();
            if(securityidsource && securityidsource=='102'){
                window.open("/etf-web/etf/download?filePath=/pcf_"+513530+"_"+date+".xml");

            }else{
                var filePath_Old = "513530" + date + ".TXT";
                var filePath_New = "etfd_513530_" + date + ".xml";
                $.ajax({
                    type: "GET",
                    url: "/etf-web/etf/checkFileisExist?filePath="+filePath_New ,
                    dataType: "json",
                    success: function (data) {
                        if (data != null && data.success) {
                            window.open("/etf-web/etf/download?filePath="+ filePath_New);
                        } else {
                            window.open("/etf-web/etf/download?filePath="+filePath_Old);
                        }
                    }
                });
            }
        });

