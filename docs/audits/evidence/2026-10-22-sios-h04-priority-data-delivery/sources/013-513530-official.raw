									yearList.push(2024);
									sessionList.push({year:2024,session:4});
									yearList.push(2024);
									sessionList.push({year:2024,session:3});
									yearList.push(2024);
									sessionList.push({year:2024,session:2});
									yearList.push(2024);
									sessionList.push({year:2024,session:1});
									yearList.push(2023);
									sessionList.push({year:2023,session:4});
									yearList.push(2023);
									sessionList.push({year:2023,session:3});
									yearList.push(2023);
									sessionList.push({year:2023,session:2});
									yearList.push(2023);
									sessionList.push({year:2023,session:1});
									yearList.push(2022);
									sessionList.push({year:2022,session:4});
									yearList.push(2022);
									sessionList.push({year:2022,session:3});
									yearList.push(2022);
									sessionList.push({year:2022,session:2});
                                var obj = {};//用于标记字符串
                                var arr = [];//去掉重复后的数组
                                for (var i = 0, len = yearList.length; i < len; i++) {
                                    var s = yearList[i];
                                    if (obj[s]) continue;//如果字符串已经存在就跳过
                                    else {
                                        obj[s] = s;//加入标记对象中
                                        arr.push(s);//结果放入新数组中
                                    }
                                }
                                arr=arr.sort().reverse();
                                for (var i = 0; i<arr.length;i++) {
                                    if(i==0){
                                        $(".year-text").attr("data-id",arr[i]);
                                        $(".year-text").html(arr[i]+"年");
                                    }
                                    $("#year").append("<p data-id="+arr[i]+" class=\"option\">"+arr[i]+"年</p>");
                                }
                            </script>
                            <div class="select-option-box" id="quarter">
                            </div>
                            <script>



                                var currQuarter=null;
                                if(sessionList.length>0){
                                    currQuarter=sessionList[0].session;
                                }else{
                                    var currMonth= new Date().getMonth()+1;
                                    currQuarter= Math.floor( (currMonth%3 == 0 ? (currMonth/3):(currMonth/3 + 1) ) );
                                }




                                $(".quarter-text").attr("data-id",currQuarter)
                                if(currQuarter==1){
                                    $(".quarter-text").html("第一季度")
                                }else if(currQuarter==2){
                                    $(".quarter-text").html("第二季度")
                                }else if(currQuarter==3){
                                    $(".quarter-text").html("第三季度")
                                }else if(currQuarter==4){
                                    $(".quarter-text").html("第四季度")
                                }
                            </script>



