    function changeHbNetValueTop(time,legendAll,container){
        queryChart('513530',time, '', '', '9496d23c648f4a72a79150c3f2ac669b', container, legendAll,"1",0);
    }

    function changeNetValueTop(timer,legendAll,container){
        var oldDate = new Date();
        var currDate = new Date();
        var months = "01";//月
        var days = "01";//天
        if(timer==0){//成立以来
            if(project.setupdate!="undefined"){
                oldDate = project.setupdate;
            }else{
                oldDate = "2018-01-01";
            }
        }else if (timer==1){//今年以来
            oldDate = currDate.getFullYear()+"-01-01";
        }else{
            oldDate.setTime(currDate.getTime()-timer*24*3600*1000);
            months = oldDate.getMonth()+1;
            days = oldDate.getDate();
            if(months < 10){months = "0" + months;}
            if(days < 10){days = "0" + days;}
            oldDate = oldDate.getFullYear() + "-" + months + "-" + days;
        }
        months = currDate.getMonth()+1;
        days = currDate.getDate();
        if(months < 10){months = "0" + months;}
        if(days < 10){days = "0" + days;}
        currDate = currDate.getFullYear() + "-" + months + "-" + days;


        var profitDateArr = [];
        var profitDate = '';
        var dataArr = '';
        var dateStr = '';
        var fenhongData = '';

			profitDate = '2026-10-19';
			dataArr = profitDate.split('-');
			dateStr = dataArr[0] + '-' + parseInt(dataArr[1]) + '-' + parseInt(dataArr[2]);
			profitDate = dateStr;
			fenhongData = 0.1;
			profitDateArr.push({
                date: profitDate,
                data: fenhongData
            });
			profitDate = '2026-09-14';
			dataArr = profitDate.split('-');
			dateStr = dataArr[0] + '-' + parseInt(dataArr[1]) + '-' + parseInt(dataArr[2]);
			profitDate = dateStr;
			fenhongData = 0.1;
			profitDateArr.push({
                date: profitDate,
                data: fenhongData
            });
			profitDate = '2026-08-17';
			dataArr = profitDate.split('-');
			dateStr = dataArr[0] + '-' + parseInt(dataArr[1]) + '-' + parseInt(dataArr[2]);
			profitDate = dateStr;
