                            <script>
                                var yearList=[];
                                var sessionList=[];
									yearList.push(2026);
									sessionList.push({year:2026,session:2});
									yearList.push(2026);
									sessionList.push({year:2026,session:1});
									yearList.push(2025);
									sessionList.push({year:2025,session:4});
									yearList.push(2025);
									sessionList.push({year:2025,session:3});
									yearList.push(2025);
									sessionList.push({year:2025,session:2});
									yearList.push(2025);
