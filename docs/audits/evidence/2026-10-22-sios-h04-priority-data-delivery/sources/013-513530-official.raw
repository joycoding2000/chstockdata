<div class="container">
    <div class="wrapper-title">
        <div class="r">
            <p>
                <img class="search-icon" src="/assets/search-icon.png">
                <input id="searchinp" placeholder="请输入基金名称、基金代码搜索">
                <button>搜索</button>
            </p>
            <ul class="search_result">

            </ul>
        </div>
        <script>

            $("#searchinp").bind("keydown", function () {
                if (event.keyCode == 13) {
                    hotSearchs();
                }
            });

            //搜索框效果
            $("#searchinp").bind("keyup", function () {
                if ($("#searchinp").val() != "") {
                    $(".search_result").show();
                    $(".search_result").find("li").remove();
                    var searchList = ''
                    var allFundsDatas = allFunds
                    var _val=$("#searchinp").val().toUpperCase();
                    for (var i = 0; i < allFundsDatas.length; i++) {
                        var namecode = allFundsDatas[i].split(",");
                        var shortname=makePy(namecode[1]).toString();
                        if (namecode[0].indexOf(_val)>-1 || namecode[1].indexOf(_val)>-1 || namecode[6].indexOf(_val)>-1 || shortname.indexOf(_val)>-1) {
                            if (namecode[5] == 1) {
                                searchList += '<li><a href="/category/product-asset/' + namecode[0] + '/index.html?id=' + namecode[4] + '" target="_blank" title="' + namecode[1] + ' [' + namecode[0] + ']"><span class="snum">' + namecode[2] + '</span>' + namecode[1] + '</a></li>'
                            } else {
                                searchList += '<li class="search-lis"><a href="' + namecode[4] + '" target="_blank" title="' + namecode[1] + ' [' + namecode[0] + ']"><span class="snum">' + namecode[2] + '</span><span class="snum">(' + namecode[0] + ')-</span>' + namecode[1] + '</a></li>'
                            }
                        }
                    }
                    /*     console.log(searchList);*/
                    $(".search_result").html(searchList);
                } else {
                    $(".search_result").hide();
                }
            });
            $("#searchinp").bind("click", function (e) {
                e.stopPropagation();
            });
            $(document).bind("click", function () {
                $(".search_result").hide();
            });

            function hotSearchs() {
                window.open("/search.html?&queryStrings="+$("#searchinp").val(),'_blank');
            }

        </script>
    </div>
