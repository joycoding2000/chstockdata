    function countDown(){
        /**判断当前时间是否大于开始日期**/
       var beginDate=  project.subscriptionBeginDate.split("-");
        var month1=beginDate[1]<10?'0'+beginDate[1]:beginDate[1];
        var day1=beginDate[2]<10?'0'+beginDate[2]:beginDate[2];
        var endTime1=beginDate[0]+'-'+month1+'-'+day1+" 00:00:00";
        var customTime=new Date(endTime1);
        // 认购结束时间(个位数添0)
        var endDateList=project.subscriptionEndDate.split("-");
        var month=endDateList[1]<10?'0'+endDateList[1]:endDateList[1];
        var day=endDateList[2]<10?'0'+endDateList[2]:endDateList[2];
        var endTime=endDateList[0]+'-'+month+'-'+day+" 16:00:00";
        // 当前时间
        var currentTime = new Date();
        var currentTimeNum = currentTime.getTime();
        // 认购结束时间
        var finishTime = new Date(project.subscriptionEndDate + ' 16:00:00');
	var fstatus = project.status;
        // 如果当前时间小于开始时间(未开始认购)倒计时隐藏
        if(currentTime<customTime){
            $(".buy-time").hide();
        }
        // 如果当前时间在认购时间内
	var fcode = 513530;
        if (currentTime>=customTime&&currentTime<finishTime) {
	    //认购期的基金产品，如果状态是15，认购按钮置灰
	    if (fstatus =="15")
	    {
		$("#rgq-btn-n").show();
		$("#rg-btn").hide();
		$("#dt-btn-n").hide();
		$("#buy-btn-n").hide();
	    }
	    else if (fstatus !="15")
	    {
            $("#rg-btn").show();
	    }
            clearInterval(timeinterval);
            var timeinterval = setInterval(() => {
                var startTime=new Date().format("yyyy-MM-dd hh:mm:ss");
            var times = getTimeRemaining(startTime,endTime);


            if(times.days<10){					// 剩余天
                times.days="0"+times.days;
            }
            $("#days").html(times.days);
            if(times.hours<10){					// 剩余时
                times.hours="0"+times.hours;
            }
            $("#hours").html(times.hours);
            if(times.minutes<10){				// 剩余分
                times.minutes="0"+times.minutes;
            }
            $("#minutes").html(times.minutes);
            if(times.seconds<10){				// 剩余秒
                times.seconds="0"+times.seconds;
            }
            $("#seconds").html(times.seconds);

            // 如果认购时间结束  倒计时暂停
            if (times.total <= 0) {
                clearInterval(timeinterval);
            }
        },1000);
        }

        // 如果认购结束 认购按钮置灰 倒计时隐藏
        if(currentTime>=finishTime){
            $("#rg-btn").removeClass("btn").addClass("nbtn").show();
            $(".buy-time").hide();
        }
    }

