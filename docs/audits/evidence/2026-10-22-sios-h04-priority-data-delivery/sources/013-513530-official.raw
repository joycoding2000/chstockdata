    function creatQuarter(year){
        var jdList=[];
        for(var j=0;j<sessionList.length;j++){
            if(sessionList[j].year==year){
                jdList.push(sessionList[j].session);
            }
        }
        $("#quarter").empty();
        var quarterHtml="";
        for(var i=0;i<jdList.length;i++){
            if(jdList[i]==1){
                quarterHtml+='<p class="option" data-id="1">第一季度</p>';
            }else if(jdList[i]==2){
                quarterHtml+='<p class="option" data-id="2">第二季度</p>';
            }else if(jdList[i]==3){
                quarterHtml+='<p class="option" data-id="3">第三季度</p>';
            }else{
                quarterHtml+='<p class="option" data-id="4">第四季度</p>';
            }
        }
        $("#quarter").append(quarterHtml);
        yearAcquiesce(jdList[0]);
    }

    function yearAcquiesce(num) {
        var content="";
        if(num==1){
            content="第一季度";
        }else if(num==2){
            content="第二季度";
        }else if(num==3){
            content="第三季度";
        }else if(num==4){
            content="第四季度";
        }
        $('.quarter-text').text(content)
        $('.quarter-text').attr("data-id",num)
        $('#quarter').hide();
        $('.select:last').css('background','');
        showTzzh();
    }
    function showTzzh(){
        var year=$(".year-text").attr("data-id");

        var jd=$(".quarter-text").attr("data-id");
        var jdrq="";
        if(jd==1){
            jdrq="-03-31"
        }else if(jd==2){
            jdrq="-06-30"
        }else if(jd==3){
            jdrq="-09-30"
        }else if(jd==4){
            jdrq="-12-31"
        }

        var dataKey = [
        ];
        let y_j = year+"_"+jd;
        // 港股tab由JS动态控制：无数据则隐藏，有数据则显示
        // 注意：dataKey中存的是 'hyfbggs-2026_2' 格式（含横杠），需用 'hyfbggs-'+y_j 匹配
        if(dataKey.includes('hyfbggs-'+y_j)) {
            $("#hyfbggsTab").show()
        }else {
            $("#hyfbggsTab").hide()
        }
        var tabCount = $("#tzzhBox").find("p").filter(":visible").length;
        if (tabCount === 2) {
            $("#tzzhBox").css("width", "302px");
        } else {
            $("#tzzhBox").css("width", "452px");
        }
        var ccdate=year+jdrq;
        $(".ccdate").html(ccdate);
	$(".tzzhs,.zcfbs,.hyfbggs,.hyfbags,.stock-top-10").hide();
        $("#tzzhBox").find('p').eq(0).addClass('active').siblings().removeClass('active');
        $("#tzzh_"  + y_j).show();
        $("#zcfbs-" + y_j).show();
        $("#gpccs-" + y_j).show();
        $("#zqccs-" + y_j).show();
    }


    $(function(){
        // 设置button锚点事件
        $('.bottom-part').on('click', '.bottom-nav-item.inline',function () {
            $("#ymtz").val("1")
            $(this).addClass('active').siblings().removeClass('active')
            $('html,body').animate({
                scrollTop: document.getElementById($(this).attr('data-href')).offsetTop
            }, 200)
        })

        // 投资组合-资产净值数据来源点击事件


        // 投资组合-资产净值数据来源点击事件
        $('#quarter').on('click', 'p', function () {
            $('.quarter-text').text($(this).text())
            $('.quarter-text').attr("data-id",$(this).attr("data-id"))
            $('#quarter').hide();
            $('.select:last').css('background','');
            showTzzh();
        })

        // 投资组合-资产净值数据来源点击事件
        $('#year').on('click', 'p', function () {
            $('.year-text').attr("data-id",$(this).attr("data-id"));
            $('.year-text').text($(this).text());
            $('#year').hide();
            $('.select:first').css('background','');
            creatQuarter($(this).attr("data-id"));
        })

        // 切换收益走势tab事件
        $('.fund-echarts-tab-box').on('click', '.fund-echarts-tab-item', function () {
            $(this).addClass('active').siblings().removeClass('active')
            var className=$(this).attr("data-id");
            $(".chertline").hide();
            $("."+className+"").show();
        })

        //切换收益走势-月份tab事件
        $('#product-income-inczs').on('click', '.change-fund-echarts-item', function () {
            $(this).addClass('active').siblings().removeClass('active');
            queryNetIncChartJson('513530', '', '', '' ,$(this).attr("timer"), 'fund-echarts-inczs', '1');
        })

        $('#product-income-dwjz').on('click', '.change-fund-echarts-item', function () {
            $(this).addClass('active').siblings().removeClass('active');
            changeNetValueTop($(this).attr("timer"),"1","fund-echarts-dwjz");
        })

        $('#product-income-ljjz').on('click', '.change-fund-echarts-item', function () {
            $(this).addClass('active').siblings().removeClass('active');
            changeNetValueTop($(this).attr("timer"),"2","fund-echarts-ljjz");
        })

        $('#product-income-hbsyl').on('click', '.change-fund-echarts-item', function () {
            $(this).addClass('active').siblings().removeClass('active');
            changeHbNetValueTop($(this).attr("timer"),"1","fund-echarts-hbsyl");
        })

        $('#product-income-qrnh').on('click', '.change-fund-echarts-item', function () {
            $(this).addClass('active').siblings().removeClass('active');
            changeHbNetValueTop($(this).attr("timer"),"2","fund-echarts-qrnh");
        })


        // 持仓占比 切换tab
        $('.position-ratio').on('click', '.change-fund-echarts-item', function () {
            var year=$(".year-text").attr("data-id");
            var jd=$(".quarter-text").attr("data-id");
            var itemName=$(this).attr("data-id");
            if(itemName=="zcfbs"){
                $(".hyfbags,.hyfbggs").hide();
                $("#zcfbs-"+year+"_"+jd).show();
            }else if(itemName=="hyfbags"){
                $(".zcfbs,.hyfbggs").hide();
                $("#hyfbags-"+year+"_"+jd).show();
            }else if(itemName=="hyfbggs"){
                $(".zcfbs,.hyfbags").hide();
                $("#hyfbggs-"+year+"_"+jd).show();
            }
            $(this).addClass('active').siblings().removeClass('active')
        })

        $('#news-list-box').on('click', '.change-fund-echarts-item', function () {
            $(this).addClass('active').siblings().removeClass('active')
        })



    });



    // 侧边悬浮
    $(function(){
        $(".rmenu a").hover(function(){
            $(this).find(".sidebox").stop().animate({"width":"120px"},200).css({"opacity":"1","filter":"Alpha(opacity=100)","background":"#fff"})
            $(this).css('overflow','inherit');
        },function(){
            $(this).find(".sidebox").stop().animate({"width":"40px"},200).css({"opacity":"0","filter":"Alpha(opacity=0)","background":"#bd9126"})
            $(this).css('overflow','hidden');
        },function(){
            $(this).find(".sidebox").stop().animate({"width":"40px"},200).css({"opacity":"0","filter":"Alpha(opacity=0)","background":"#bd9126"})
            $(this).css('overflow','hidden');
        });

        $(".btn_top").hide();
        $(".btn_top").on("click", function () {
            $('html, body').animate({scrollTop: 0}, 300);
            return false;
        });

        $(window).bind('scroll resize', function () {
            if ($(window).scrollTop() <= 300) {
                $(".btn_top").hide();
            } else {
                $(".btn_top").show();
            }
        });
    })

</script>

