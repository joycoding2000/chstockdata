+def same_page_unit_block(previous, current, page_no, lines):
+    """One monetary summary may have adjacent flow and balance sub-tables."""
+    if not previous or previous['page'] != page_no or not previous.get('unit'):
+        return None
+    a, b = previous['bbox'], current['bbox']
+    if not 0 <= b[1]-a[3] <= 30 or len(previous['edges']) != len(current['edges']):
+        return None
+    if any(abs(x-y)>3 for x,y in zip(previous['edges'], current['edges'])):
+        return None
+    between = ''.join(l['text'] for l in lines if a[3] <= l['top'] < b[1])
+    if compact(between):
+        return None
+    return {'previous_page': page_no, 'current_page': page_no,
+            'reason': 'ADJACENT_SAME_PAGE_ALIGNED_SUBTABLES_NO_INTERVENING_TEXT',
+            'previous_bbox': a, 'current_bbox': b, 'matching_column_edges': current['edges']}
