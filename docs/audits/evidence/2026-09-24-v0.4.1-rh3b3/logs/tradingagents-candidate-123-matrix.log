validated_upstream_results = (), allow_failed_result = True
active_result_ids = frozenset()

    def _validate_analysis_output(
        materialized_output: Phase2NodeResult | Mapping[str, Any],
        node_projection_manifest: PromptProjectionManifest,
        admitted_snapshot: AdmittedResearchSnapshot,
        validated_upstream_results: Sequence[ValidatedPhase2Result] = (),
        *,
        allow_failed_result: bool = False,
        active_result_ids: frozenset[str] = frozenset(),
    ) -> ValidatedPhase2Result:
        _assert_admitted(admitted_snapshot)
        if not isinstance(node_projection_manifest, PromptProjectionManifest):
            try:
                node_projection_manifest = PromptProjectionManifest.model_validate(
                    node_projection_manifest
                )
            except (ValidationError, TypeError, ValueError) as exc:
                raise Phase2ContractValidationError(
                    f"projection manifest validation failed: {exc}"
                ) from exc
        manifest = node_projection_manifest
        upstream = tuple(validated_upstream_results)
        result = _reparse_phase2_result(materialized_output)
        if result.result_id in active_result_ids:
            raise Phase2ContractValidationError("cyclic Step 3 validated-result chain")
        _check_manifest_identity(manifest, admitted_snapshot)
        if result.node_name != manifest.node_name:
            raise Phase2ContractValidationError(
                "Phase2NodeResult node_name differs from its actual projection manifest"
            )
        _validate_code_owned_ids(result, admitted_snapshot.context)
        try:
            expected_projection = build_node_projection(
                admitted_snapshot,
                manifest.node_name,
                manifest.budget_policy,
                validated_upstream_results=upstream,
                basis_assessment=manifest.basis_assessment,
                _active_result_ids=active_result_ids | {result.result_id},
            )
        except (PromptProjectionError, InsufficientResearchBasisError, Phase2UpstreamExecutionFailure):
            raise
        except (TypeError, ValueError) as exc:
            raise Phase2ContractValidationError(
                f"projection manifest cannot be reproduced from admitted inputs: {exc}"
            ) from exc
        if expected_projection.manifest.model_dump(mode="json") != manifest.model_dump(
            mode="json"
        ):
            raise Phase2ContractValidationError(
                "projection manifest/digest does not match deterministic admitted input"
            )
        if result.snapshot_fingerprint != admitted_snapshot.context.snapshot_fingerprint:
            raise Phase2ContractValidationError(
                "node result has a foreign Snapshot fingerprint"
            )
        if result.execution_status.value != "completed":
            if not allow_failed_result:
                raise Phase2ContractValidationError(
