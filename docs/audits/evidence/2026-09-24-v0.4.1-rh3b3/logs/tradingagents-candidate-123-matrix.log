                )
            if basis_assessment.policy_id != admitted_snapshot.context.research_basis_policy_id:
                raise Phase2ContractValidationError(
                    "basis assessment policy differs from GraphContext"
                )
            if basis_assessment.status is ResearchBasisStatus.UPSTREAM_EXECUTION_FAILURE:
                raise Phase2UpstreamExecutionFailure(
