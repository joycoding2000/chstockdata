        if normalized_node not in _ALL_NODE_NAMES:
            raise Phase2ContractValidationError(f"unsupported Phase 2 node: {normalized_node}")
        if prompt_budget_policy.policy_id != admitted_snapshot.context.prompt_budget_policy_id:
            raise Phase2ContractValidationError(
                "PromptBudgetPolicy ID does not match GraphContext"
            )
        upstream = tuple(validated_upstream_results)
        _validate_upstream_names(normalized_node, upstream)
