            if basis_assessment.snapshot_fingerprint != admitted_snapshot.context.snapshot_fingerprint:
                raise Phase2ContractValidationError(
                    "basis assessment fingerprint differs from GraphContext"
                )
            if basis_assessment.policy_id != admitted_snapshot.context.research_basis_policy_id:
                raise Phase2ContractValidationError(
                    "basis assessment policy differs from GraphContext"
                )
            if basis_assessment.status is ResearchBasisStatus.UPSTREAM_EXECUTION_FAILURE:
                raise Phase2UpstreamExecutionFailure(
                    next(
                        wrapper.result
                        for wrapper in upstream
                        if wrapper.result.result_id == basis_assessment.execution_failure_result_id
                    )
                )
            if basis_assessment.status is not ResearchBasisStatus.READY_FOR_FINAL:
                raise InsufficientResearchBasisError(basis_assessment)
        elif basis_assessment is not None:
