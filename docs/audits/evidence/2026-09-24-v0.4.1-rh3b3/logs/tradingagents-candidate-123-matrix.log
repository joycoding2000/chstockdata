    def _validate_grounded_statement(
        statement: GroundedStatement,
        manifest: PromptProjectionManifest,
        admitted: AdmittedResearchSnapshot,
        content_index,
    ) -> None:
        try:
            # Reparse the serialized statement so model_copy/update cannot bypass
            # Step 2's template, slot, and no-unbacked-number rules.
            type(statement).model_validate(statement.model_dump(mode="json"))
        except ValidationError as exc:
            raise Phase2ContractValidationError(
                f"GroundedStatement numeric/template validation failed: {exc}"
            ) from exc
        roots = _validate_citation_bundle(
            statement.citations, manifest, admitted, content_index
        )
        _validate_date_literals(statement, manifest, admitted, content_index)
        kind = statement.statement_kind
        if kind in {StatementKind.INTERPRETATION, StatementKind.MONITORING_CONDITION}:
            has_direct_layer = bool(
                statement.citations.fact_ids or statement.citations.material_ids
            )
            has_upstream_layer = bool(
                statement.citations.upstream_result_ids
                or statement.citations.upstream_statement_ids
                or statement.citations.upstream_reason_ids
            )
            if not (has_direct_layer or (has_upstream_layer and roots)):
