+@pytest.mark.parametrize('reverse', [False, True])
+def test_type_identity_anchor_change(monkeypatch, reverse):
+    pages = real_pages('sz300750')
+    first, anchor = json.loads(pages[1]), json.loads(pages[1])
+    values = [1, {'json_number': '1'}]
+    if reverse:
+        values.reverse()
+    for rows, value in zip((first, anchor), values):
+        next(row for row in rows if row['opendate'] == '2026-09-15')['r0_net'] = value
+    calls = transport(monkeypatch, {}, sequence=[synthetic(first), pages[2], synthetic(anchor)])
+    r = cs.get_sina_daily_fund_flow('SZ', '300750', target_date='2026-09-15', calendar=calendar())
+    row = r.records[-1]
+    assert r.pagination['stop_reason'] == 'ANCHOR_DRIFT' and r.status == 'PARTIAL'
+    assert r.pagination['consistency'] == 'UNKNOWN' and len(calls) == 3
+    assert row['status'] == 'DUPLICATE_CONFLICT' and row['amount'] is None
+    assert len(row['variants']) == 2
+    assert {v['raw_type'] for v in row['variants']} == {'number', 'object'}
+    assert {v['references'][0]['response_index'] for v in row['variants']} == {0, 2}
+    assert r.coverage['numeric_complete_count'] == r.coverage['semantic_usable_count'] == 4
+    assert r.coverage['denominator'] == sum(r.coverage['counts'].values()) == 5
